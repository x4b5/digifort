---
/** Grote getallen met één zin erbij. `items`: [{ getal, tekst, bron }]. */
const { items } = Astro.props;
---
<ul class="cijfers">
  {items.map((c) => (
    <li>
      <strong class="getal">{c.getal}</strong>
      <span class="tekst">{c.tekst}</span>
      {c.bron && <span class="bron">{c.bron}</span>}
    </li>
  ))}
</ul>
<style>
  .cijfers { list-style: none; padding: 0; margin: 1.5rem 0 2rem; display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); }
  .cijfers li { margin: 0; padding: 1rem 1.1rem; border: var(--lijndikte) solid var(--lijn-sterk); border-radius: var(--radius); display: flex; flex-direction: column; gap: 0.3rem; background: var(--papier); }
  .getal { font-family: var(--kop); font-size: clamp(1.9rem, 4vw, 2.4rem); line-height: 1; color: var(--rood); letter-spacing: -0.02em; }
  .tekst { font-size: 0.97rem; line-height: 1.4; }
  .bron { font-family: var(--kop); font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--inkt-flauw); margin-top: auto; padding-top: 0.3rem; }
</style>
