---
/**
 * Grote getallen met één zin erbij. `items`: [{ getal, tekst, bron, href }].
 * `href` wijst naar de bron zelf; zonder href gaat de lezer naar de bronnenlijst,
 * want een cijfer zonder narekenbare bron hoort hier niet.
 * Eindigt `getal` op een procent, dan krijgt het blok een ring die dat deel van
 * het geheel laat zien.
 */
interface Props { items: { getal: string; tekst: string; bron?: string; href?: string }[] }
const { items } = Astro.props;
const procent = (getal: string) => {
  const m = getal.trim().match(/^(\d+(?:,\d+)?)\s*%$/);
  return m ? Math.min(Number(m[1].replace(',', '.')), 100) : null;
};
---
<ul class="cijfers">
  {items.map((c) => (
    <li>
      <span class="kop">
        <strong class="getal">{c.getal}</strong>
        {procent(c.getal) !== null && (
          <svg class="ring" viewBox="0 0 36 36" aria-hidden="true" style={`--deel: ${procent(c.getal)}`}>
            <circle class="ring-baan" cx="18" cy="18" r="15" pathLength="100" />
            <circle class="ring-deel" cx="18" cy="18" r="15" pathLength="100" />
          </svg>
        )}
      </span>
      <span class="tekst">{c.tekst}</span>
      {c.bron && <a class="bron" href={c.href ?? '/bronnen'}>{c.bron}</a>}
    </li>
  ))}
</ul>
<script>
  // Het eerste getal in elk blok telt op vanaf 0 zodra het in beeld komt; de rest
  // van de tekst ("%", "van de 10") blijft staan. De HTML heeft het echte getal,
  // dus zonder JavaScript of bij 'minder beweging' staat dat er gewoon.
  const DUUR = 1200;
  const GETAL = /\d{1,3}(?:\.\d{3})+|\d+/;
  const opmaak = new Intl.NumberFormat('nl-NL');
  const rustig = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Het getal telt in een eigen span; het blok houdt via data-eind vanaf het begin
  // de ruimte van het eindgetal vast, zodat er niets verspringt als het groeit.
  function telOp(el: HTMLElement, doel: number, voor: string, na: string) {
    const start = performance.now();
    const stap = (nu: number) => {
      const t = Math.min((nu - start) / DUUR, 1);
      const zacht = 1 - (1 - t) ** 3; // snel beginnen, rustig uitlopen
      el.firstElementChild!.textContent = voor + opmaak.format(Math.round(doel * zacht)) + na;
      if (t < 1) requestAnimationFrame(stap);
    };
    requestAnimationFrame(stap);
  }

  if (!rustig && 'IntersectionObserver' in window) {
    const kijker = new IntersectionObserver((treffers) => {
      for (const t of treffers) {
        if (!t.isIntersecting) continue;
        kijker.unobserve(t.target);
        const el = t.target as HTMLElement;
        el.closest('li')?.classList.remove('wacht');
        const { voor = '', doel = '0', na = '' } = el.dataset;
        telOp(el, Number(doel), voor, na);
      }
    }, { threshold: 0.6 });
    for (const el of document.querySelectorAll<HTMLElement>('.cijfers .getal')) {
      const tekst = el.textContent ?? '';
      const treffer = tekst.match(GETAL);
      if (!treffer || treffer.index === undefined) continue;
      el.dataset.voor = tekst.slice(0, treffer.index);
      el.dataset.doel = treffer[0].replaceAll('.', '');
      el.dataset.na = tekst.slice(treffer.index + treffer[0].length);
      el.dataset.eind = tekst;
      const tel = document.createElement('span');
      tel.textContent = el.dataset.voor + '0' + el.dataset.na;
      el.replaceChildren(tel);
      el.closest('li')?.classList.add('wacht');
      kijker.observe(el);
    }
  }
</script>
<style>
  .cijfers { list-style: none; padding: 0; margin: 1.5rem 0 2rem; display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr)); }
  .cijfers li { margin: 0; padding: 1rem 1.1rem; border: var(--lijndikte) solid var(--lijn-sterk); border-radius: var(--radius); display: flex; flex-direction: column; gap: 0.3rem; background: var(--papier); transition: background-color 0.15s ease; }
  .cijfers li:hover { background: var(--rood-licht); }
  @media (prefers-reduced-motion: reduce) { .cijfers li { transition: none; } }
  .getal { font-family: var(--kop); font-size: clamp(1.9rem, 4vw, 2.4rem); line-height: 1; color: var(--rood); letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .getal[data-eind] { display: grid; }
  .getal[data-eind] > :global(span), .getal[data-eind]::after { grid-area: 1 / 1; }
  .getal[data-eind]::after { content: attr(data-eind); visibility: hidden; }
  .kop { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
  /* De ring loopt in dezelfde tijd en met dezelfde vertraging als het optellen. */
  .ring { width: 2.6rem; height: 2.6rem; flex: none; transform: rotate(-90deg); }
  .ring circle { fill: none; stroke-width: 5; }
  .ring-baan { stroke: var(--lijn); }
  .ring-deel {
    stroke: var(--rood);
    stroke-dasharray: 100 100;
    stroke-dashoffset: calc(100 - var(--deel));
    transition: stroke-dashoffset 1.2s cubic-bezier(0.33, 1, 0.68, 1);
  }
  .wacht .ring-deel { stroke-dashoffset: 100; transition: none; }
  @media (prefers-reduced-motion: reduce) { .ring-deel { transition: none; } }
  .tekst { font-size: 0.97rem; line-height: 1.4; }
  .bron { font-family: var(--kop); font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--inkt-zacht); margin-top: auto; padding-top: 0.3rem; text-decoration-thickness: 1px; }
  .bron:hover { color: var(--rood); }
</style>
