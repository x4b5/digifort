---
import Logo from './Logo.astro';
import HoofdstukIcoon from './HoofdstukIcoon.astro';
import Lezen from './Lezen.astro';
import { HOOFDSTUKKEN, SITE } from '../lib/site.js';
import { FORTDELEN } from '../data/fort.js';
import { TOTAAL_SLOTEN } from '../data/lijsten.js';
const huidig = Astro.url.pathname.replace(/\/$/, '');
---
<header class="kop">
  <div class="wrap kop-rij">
    <a class="merk" href="/"><Logo maat={34} /><span>{SITE.naam}</span></a>
    <a class="sloten" href="/#fort" data-sloten title="Je fort: elk blokje is een deel"><span class="kantelen" aria-hidden="true">{FORTDELEN.map((d) => <span data-kanteel={d.id}></span>)}</span><span data-sloten-tekst>{`0 van ${TOTAAL_SLOTEN} sloten dicht`}</span></a>
    <Lezen />
    <details class="menu">
      <summary class="knop licht klein">Menu</summary>
      <nav aria-label="Hoofdstukken">
        <ol>
          {HOOFDSTUKKEN.map((h) => (
            <li class={h.extra ? 'extra' : ''}>
              <a href={`/${h.slug}`} aria-current={huidig === `/${h.slug}` ? 'page' : undefined}>
                <HoofdstukIcoon slug={h.slug} maat={22} /><span class="nr">{h.nr === null ? '↳' : h.nr}</span> {h.titel}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </details>
  </div>
</header>

<script>
  // De uitklappers in de kop (Lezen en Menu) sluiten met Escape en
  // bij een klik ernaast. Zonder dit blijft een open menu hangen.
  const uitklappers = Array.from(document.querySelectorAll<HTMLDetailsElement>('.kop details'));

  function sluitAndere(open: HTMLDetailsElement | null) {
    uitklappers.forEach((d) => { if (d !== open) d.open = false; });
  }

  uitklappers.forEach((d) => {
    d.addEventListener('toggle', () => { if (d.open) sluitAndere(d); });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = uitklappers.find((d) => d.open);
    if (!open) return;
    open.open = false;
    open.querySelector('summary')?.focus();
  });

  document.addEventListener('click', (e) => {
    const doel = e.target as Node;
    uitklappers.forEach((d) => { if (d.open && !d.contains(doel)) d.open = false; });
  });
</script>

<style>
  .kop { border-bottom: var(--lijndikte) solid var(--lijn-sterk); background: var(--papier); position: sticky; top: 0; z-index: 5; }
  .kop-rij { display: flex; align-items: center; gap: 1rem; min-height: 4.25rem; flex-wrap: wrap; }
  .merk { display: inline-flex; align-items: center; gap: 0.6rem; font-family: var(--kop); font-weight: 700; font-size: 1.25rem; color: var(--inkt); text-decoration: none; }
  .sloten { margin-left: auto; font-size: 0.9rem; color: var(--inkt-zacht); display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none; }
  .sloten:hover { color: var(--inkt); }
  .kantelen { display: inline-flex; align-items: flex-end; gap: 2px; height: 14px; }
  .kantelen span { display: block; width: 7px; height: 9px; border: 2px solid var(--lijn-sterk); border-bottom: 0; opacity: 0.4; }
  .kantelen span:nth-child(odd) { height: 14px; }
  .kantelen span[data-toestand="dicht"] { background: var(--groen); border-color: var(--groen); opacity: 1; }
  .kantelen span[data-toestand="open"] { background: var(--rood); border-color: var(--rood); opacity: 1; }
  @media (max-width: 30rem) { .sloten [data-sloten-tekst] { display: none; } }
  .sloten[hidden] { display: none; }
  .sloten + :global(.lezen) { margin-left: 0; }
  .menu { position: relative; }
  .sloten[hidden] ~ :global(.lezen) { margin-left: auto; }
  summary { list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .menu[open] summary { background: var(--inkt); color: var(--papier); border-color: var(--inkt); }
  /* net als bij het leespaneel: een dichte <details> mag geen lay-out maken */
  .menu:not([open]) nav { display: none; }
  nav {
    position: absolute; right: 0; top: calc(100% + 0.5rem); z-index: 10;
    background: var(--papier); border: var(--lijndikte) solid var(--lijn-sterk); border-radius: var(--radius);
    min-width: min(22rem, 90vw); padding: 0.5rem 0; box-shadow: 0 10px 30px rgba(0,0,0,0.12);
  }
  ol { list-style: none; margin: 0; padding: 0; }
  li { margin: 0; }
  li a { display: flex; align-items: center; gap: 0.6rem; padding: 0.55rem 1rem; color: var(--inkt); text-decoration: none; font-size: 1rem; }
  li a:hover, li a[aria-current="page"] { background: var(--papier-2); }
  li a[aria-current="page"] { font-weight: 700; }
  .nr { font-family: var(--kop); color: var(--rood); min-width: 1.2rem; text-align: right; }
  li.extra a { padding-left: 1.6rem; color: var(--inkt-zacht); }
</style>
