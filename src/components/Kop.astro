---
import Logo from './Logo.astro';
import HoofdstukIcoon from './HoofdstukIcoon.astro';
import Lezen from './Lezen.astro';
import { HOOFDSTUKKEN, SITE } from '../lib/site.js';
import { FORTDELEN } from '../data/fort.js';
import { TOTAAL_SLOTEN } from '../data/lijsten.js';
const huidig = Astro.url.pathname.replace(/\/$/, '');
---
<header class="kop">
  <div class="wrap kop-rij">
    <a class="merk" href="/"><Logo maat={34} /><span>{SITE.naam}</span></a>
    <a class="sloten" href="/#fort" data-sloten title="Je fort: elk blokje is een deel"><span class="kantelen" aria-hidden="true">{FORTDELEN.map((d) => <span data-kanteel={d.id}></span>)}</span><span data-sloten-tekst>{`0 van ${TOTAAL_SLOTEN} sloten dicht`}</span></a>
    <p class="feestje" data-feestje role="status" aria-live="polite"></p>
    <Lezen />
    <details class="menu">
      <summary class="knop licht klein geen-driehoek">Menu</summary>
      <nav class="paneel" aria-label="Hoofdstukken">
        <ol>
          {HOOFDSTUKKEN.map((h) => (
            <li class={h.extra ? 'extra' : ''}>
              <a href={`/${h.slug}`} aria-current={huidig === `/${h.slug}` ? 'page' : undefined}>
                {h.extra ? h.titel : <><HoofdstukIcoon slug={h.slug} maat={22} /><span class="nr">{h.nr}</span> {h.titel}</>}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </details>
  </div>
</header>

<script>
  import { lees } from '../lib/opslag.js';
  import { LIJSTEN, SLOT_LIJSTEN, TOTAAL_SLOTEN } from '../data/lijsten.js';
  import { toestandPerKamer } from '../lib/toestand.js';
  import { FORTDELEN, toestandPerDeel } from '../data/fort.js';

  // de teller telt de vinkjes uit de lijsten met sloten; de kantelen laten per
  // fortdeel zien of hij staat (groen), wankelt (rood) of nog onbekend is
  function telSloten(data: { lijsten: Record<string, Record<string, boolean>> }) {
    return SLOT_LIJSTEN.reduce((n, id) => {
      const items = data.lijsten[id] ?? {};
      return n + LIJSTEN[id].items.filter((it) => items[it.id]).length;
    }, 0);
  }

  function toonTeller(data = lees()) {
    const el = document.querySelector<HTMLElement>('[data-sloten]');
    const tekst = document.querySelector<HTMLElement>('[data-sloten-tekst]');
    if (!el || !tekst) return {};
    const delen = toestandPerDeel(toestandPerKamer(data));
    tekst.textContent = `${telSloten(data)} van ${TOTAAL_SLOTEN} sloten dicht`;
    el.querySelectorAll<HTMLElement>('[data-kanteel]').forEach((k) => { k.dataset.toestand = delen[k.dataset.kanteel!]; });
    return delen;
  }

  // Een deel dat nét dicht gaat, verdient een klein feestje: het kanteel springt op en
  // de kop zegt het hardop. Alleen bij een verandering, dus nooit bij het laden van een pagina.
  const FEEST_DUUR = 3500;
  let wasDicht = new Set(Object.entries(toonTeller()).filter(([, t]) => t === 'dicht').map(([id]) => id));
  let feestKlok: ReturnType<typeof setTimeout> | undefined;

  function zin(nieuw: string[], allesDicht: boolean) {
    if (allesDicht) return `Je fort staat. Alle ${FORTDELEN.length} delen.`;
    const namen = nieuw.map((id, i) => {
      const naam = FORTDELEN.find((d) => d.id === id)!.naam;
      return i === 0 ? naam : naam.charAt(0).toLowerCase() + naam.slice(1);
    });
    const opsomming = namen.length > 1 ? `${namen.slice(0, -1).join(', ')} en ${namen.at(-1)}` : namen[0];
    return `${opsomming} ${namen.length > 1 ? 'staan' : 'staat'}.`;
  }

  function vier(delen: Record<string, string>) {
    const nuDicht = new Set(Object.entries(delen).filter(([, t]) => t === 'dicht').map(([id]) => id));
    const nieuw = [...nuDicht].filter((id) => !wasDicht.has(id));
    wasDicht = nuDicht;
    if (!nieuw.length) return;
    nieuw.forEach((id) => {
      const k = document.querySelector<HTMLElement>(`[data-kanteel="${id}"]`);
      if (!k) return;
      k.classList.remove('net-dicht');
      void k.offsetWidth; // de animatie opnieuw laten beginnen als hij er al op stond
      k.classList.add('net-dicht');
    });
    const feestje = document.querySelector<HTMLElement>('[data-feestje]');
    if (!feestje) return;
    feestje.textContent = zin(nieuw, nuDicht.size === FORTDELEN.length);
    feestje.classList.add('zichtbaar');
    clearTimeout(feestKlok);
    feestKlok = setTimeout(() => feestje.classList.remove('zichtbaar'), FEEST_DUUR);
  }

  window.addEventListener('jdh:gewijzigd', (e: Event) => vier(toonTeller((e as CustomEvent).detail)));
</script>

<script>
  // De uitklappers in de kop (Lezen en Menu) sluiten met Escape en
  // bij een klik ernaast. Zonder dit blijft een open menu hangen.
  const uitklappers = Array.from(document.querySelectorAll<HTMLDetailsElement>('.kop details'));

  function sluitAndere(open: HTMLDetailsElement | null) {
    uitklappers.forEach((d) => { if (d !== open) d.open = false; });
  }

  uitklappers.forEach((d) => {
    d.addEventListener('toggle', () => { if (d.open) sluitAndere(d); });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = uitklappers.find((d) => d.open);
    if (!open) return;
    open.open = false;
    open.querySelector('summary')?.focus();
  });

  document.addEventListener('click', (e) => {
    const doel = e.target as Node;
    uitklappers.forEach((d) => { if (d.open && !d.contains(doel)) d.open = false; });
  });
</script>

<style>
  /* bij het wisselen van pagina blijft de kop staan en vloeit alleen de inhoud over */
  .kop { view-transition-name: kop; }
  @view-transition { navigation: auto; }
  .kop { border-bottom: var(--lijndikte) solid var(--lijn-sterk); background: var(--papier); position: sticky; top: 0; z-index: 5; }
  .kop-rij { display: flex; align-items: center; gap: 1rem; min-height: 4.25rem; flex-wrap: wrap; }
  .merk { display: inline-flex; align-items: center; gap: 0.6rem; font-family: var(--kop); font-weight: 700; font-size: 1.25rem; color: var(--inkt); text-decoration: none; }
  .sloten { margin-left: auto; font-size: 0.9rem; color: var(--inkt-zacht); display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none; }
  .sloten:hover { color: var(--inkt); }
  .kantelen { display: inline-flex; align-items: flex-end; gap: 2px; height: 14px; }
  .kantelen span { display: block; transform-origin: bottom center; width: 7px; height: 9px; border: 2px solid var(--lijn-sterk); border-bottom: 0; opacity: 0.4; }
  .kantelen span:nth-child(odd) { height: 14px; }
  .kantelen span[data-toestand="dicht"] { background: var(--groen); border-color: var(--groen); opacity: 1; }
  .kantelen span[data-toestand="open"] { background: var(--rood); border-color: var(--rood); opacity: 1; }
  .kantelen span.net-dicht { animation: springop 0.6s ease-out; }
  @keyframes springop { 0% { transform: none; } 35% { transform: translateY(-6px) scale(1.25); } 70% { transform: translateY(1px); } 100% { transform: none; } }
  /* het feestje hangt net onder de kop, rechts; leeg of weggeklapt neemt het geen plek in */
  .feestje { position: absolute; top: calc(100% + 0.6rem); right: max(1rem, calc((100% - var(--breed)) / 2)); margin: 0; padding: 0.55rem 0.9rem; border-radius: var(--radius); background: var(--groen); color: var(--op-kleur); font-family: var(--kop); font-weight: 700; font-size: 0.95rem; box-shadow: var(--schaduw, 0 10px 30px rgba(0,0,0,.12)); opacity: 0; transform: translateY(-6px); transition: opacity 0.25s ease, transform 0.25s ease; pointer-events: none; }
  .feestje.zichtbaar { opacity: 1; transform: none; }
  .feestje:empty { display: none; }
  @media (prefers-reduced-motion: reduce) { .kantelen span.net-dicht { animation: none; } .feestje { transition: none; transform: none; } }
  @media (max-width: 30rem) { .sloten [data-sloten-tekst] { display: none; } }
  .sloten[hidden] { display: none; }
  /* aanraakscherm: minstens 44px om met een duim te raken (WCAG 2.5.5) */
  @media (pointer: coarse) { .merk, .sloten { min-block-size: 44px; } }
  .sloten + :global(.lezen) { margin-left: 0; }
  .menu { position: relative; }
  .sloten[hidden] ~ :global(.lezen) { margin-left: auto; }
  /* net als bij het weergavepaneel: een dichte <details> mag geen lay-out maken */
  .menu:not([open]) nav { display: none; }
  nav { min-width: min(22rem, 90vw); padding: 0.5rem 0; }
  ol { list-style: none; margin: 0; padding: 0; }
  li { margin: 0; }
  li a { display: flex; align-items: center; gap: 0.6rem; padding: 0.55rem 1rem; color: var(--inkt); text-decoration: none; font-size: 1rem; }
  li a:hover, li a[aria-current="page"] { background: var(--papier-2); }
  li a[aria-current="page"] { font-weight: 700; }
  .nr { font-family: var(--kop); color: var(--rood); min-width: 1.2rem; text-align: right; }
  /* een verdieping hangt als zijtak aan het hoofdstuk erboven: de tekst begint
     onder de titel van dat hoofdstuk, met een dun lijntje als tak */
  li.extra a { margin-left: 3.4rem; padding: 0.35rem 1rem 0.35rem 1.8rem; border-left: var(--lijndikte-dun) solid var(--lijn); color: var(--inkt-zacht); font-size: 0.92rem; }
  li.extra a:hover, li.extra a[aria-current="page"] { color: var(--inkt); }
</style>
