---
/**
 * Een massief fort met een gesloten poort en een sleutelgat: dicht en op slot.
 * Geen rood, want rood betekent op deze site "staat open of gaat mis".
 * Dezelfde vorm staat in public/favicon.svg en public/apple-touch-icon.png.
 */
const { maat = 32 } = Astro.props;
---
<svg width={maat} height={maat} viewBox="0 0 40 40" aria-hidden="true" focusable="false">
  <!-- de lijn rondom rondt de hoeken af -->
  <path class="tek-vul-inkt" style="stroke: var(--lijn-sterk); stroke-width: 2; stroke-linejoin: round" d="M5 33 V13 h6 v-6 h6 v6 h6 v-6 h6 v6 h6 V33 Z" />
  <path class="tek-vul-papier" d="M15 33 V23 a5 5 0 0 1 10 0 V33 Z" />
  <circle class="tek-vul-inkt" cx="20" cy="25.5" r="1.8" />
  <path class="tek-vul-inkt" d="M19 26.5 h2 l0.6 4 h-3.2 Z" />
</svg>
