---
/**
 * Vorige en volgende pagina, onderaan elk hoofdstuk. Eén bron: buren() uit site.js.
 * Ligt de buurman in het andere deel (van Doen naar Opzoeken), dan zegt de knop dat:
 * wie klaar is met doen, moet weten dat hij nu in de naslag terechtkomt.
 */
import { buren, DELEN } from '../lib/site.js';
const { slug } = Astro.props;
const { vorige, volgende } = buren(slug);
const deelNaam = (id: string) => DELEN.find((d) => d.id === id)?.titel;
---
<nav class="buren" aria-label="Vorige en volgende">
  {vorige && (
    <a class="knop licht" href={`/${vorige.slug}`}>
      <span>← {vorige.anderDeel && <span class="ander">Terug naar {deelNaam(vorige.deel)}: </span>}{vorige.titel}</span>
    </a>
  )}
  {volgende && (
    <a class:list={['knop', { licht: volgende.anderDeel }]} href={`/${volgende.slug}`}>
      <span>{volgende.anderDeel && <span class="ander">Verder in {deelNaam(volgende.deel)}: </span>}{volgende.titel} →</span>
    </a>
  )}
</nav>
<style>
  .buren { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: space-between; margin-top: 3.5rem; padding-top: 1.5rem; border-top: var(--lijndikte) solid var(--lijn-sterk); }
  .buren a { max-width: 100%; text-align: left; }
  .ander { font-weight: 400; }
</style>
