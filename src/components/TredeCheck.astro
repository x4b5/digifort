---
/** Drie vragen, en je weet op welke trede van de ladder je e-mail staat. Niets wordt opgeslagen. */
const VRAGEN = [
  { id: 'ww', vraag: 'Hoe log je in op je e-mail?', opties: [
    ['zelfde', 'Met een wachtwoord dat ik ook ergens anders gebruik'],
    ['eigen', 'Met een eigen wachtwoord dat ik uit mijn hoofd ken'],
    ['kluis', 'Met een wachtwoord uit mijn wachtwoordmanager'],
    ['passkey', 'Zonder wachtwoord: met mijn vinger, gezicht of een sleuteltje'],
  ] },
  { id: 'stap', vraag: 'Komt er daarna nog een tweede stap?', opties: [
    ['geen', 'Nee'],
    ['sms', 'Ja, een code per sms'],
    ['app', 'Ja, een code uit een app'],
    ['passkey', 'Ja, een passkey op mijn telefoon of computer'],
    ['sleutel', 'Ja, een los sleuteltje zoals een YubiKey'],
  ] },
  { id: 'nood', vraag: 'Raak je je telefoon vandaag kwijt: kom je dan nog binnen?', opties: [
    ['nee', 'Nee, of ik weet het niet'],
    ['ja', 'Ja, ik heb herstelcodes op papier of een tweede sleutel'],
  ] },
];
---
<section class="tredecheck" data-tredecheck aria-labelledby="tredecheck-kop">
  <h2 id="tredecheck-kop">Op welke trede sta jij?</h2>
  <p class="uitleg">Drie vragen over je e-mail, want dat is je voordeur. Je antwoorden blijven op deze pagina.</p>
  {VRAGEN.map((v) => (
    <fieldset>
      <legend>{v.vraag}</legend>
      {v.opties.map(([waarde, tekst]) => (
        <label><input type="radio" name={`tc-${v.id}`} value={waarde} /><span>{tekst}</span></label>
      ))}
    </fieldset>
  ))}
  <div class="uitslag" data-uitslag hidden aria-live="polite" aria-atomic="true">
    <p class="eyebrow">Jouw trede</p>
    <p class="trede"><span class="bol" data-bol>0</span> <strong data-titel></strong></p>
    <p data-advies></p>
    <p><a class="knop klein" data-stap href="/aan-de-slag#niveau-1">Naar niveau 1 →</a> <a class="knop licht klein" data-link href="#trede-1">Lees over deze trede</a> <a class="knop licht klein" data-volgende href="#trede-2">De volgende trede</a></p>
  </div>
</section>

<script>
  import { trede as tredeInfo } from '../data/tredes.js';

  /** de vier antwoorden op vraag 1, elk met de trede die ze waard zijn */
  const START = { zelfde: 1, eigen: 2, kluis: 3, passkey: 6 };

  document.querySelectorAll<HTMLElement>('[data-tredecheck]').forEach((s) => {
    const kies = (naam: string) => s.querySelector<HTMLInputElement>(`input[name="tc-${naam}"]:checked`)?.value;

    function trede() {
      const ww = kies('ww'), stap = kies('stap'), nood = kies('nood');
      if (!ww || !stap || !nood) return null;
      let t = START[ww as keyof typeof START];
      if (stap === 'sms') t = Math.max(t, 4);
      if (stap === 'app') t = Math.max(t, 5);
      if (stap === 'passkey') t = Math.max(t, 6);
      if (stap === 'sleutel') t = Math.max(t, 7);
      if (t >= 6 && nood === 'ja') t = 8;
      return { t, ww, stap, nood };
    }

    function advies({ t, ww }: { t: number; ww: string }) {
      if (t <= 2) return { tekst: 'Begin bij een wachtwoordmanager en een tweede slot op je e-mail. Dat is niveau 1, in één avond.', naar: '/aan-de-slag#niveau-1', naarTekst: 'Naar niveau 1' };
      if (t === 3) return { tekst: 'De kluis staat. Zet nu een tweede slot op je e-mail: een code uit een app, of beter een passkey.', naar: '/aan-de-slag#niveau-2', naarTekst: 'Naar niveau 2' };
      if (t === 4) return { tekst: 'Wissel de sms-code om voor een app of een passkey. Dat kost vijf minuten per account.', naar: '/aan-de-slag#niveau-2', naarTekst: 'Naar niveau 2' };
      if (t === 5) return ww === 'kluis'
        ? { tekst: 'Sterk. Een passkey maakt het nog phishing-bestendig: zet hem aan waar je e-mail het aanbiedt.', naar: '#trede-6', naarTekst: 'Lees over de passkey' }
        : { tekst: 'Zet je wachtwoorden in een kluis en zet daarna een passkey aan.', naar: '/aan-de-slag#niveau-1', naarTekst: 'Naar niveau 1' };
      if (t === 6 || t === 7) return { tekst: 'Bijna bovenaan. Alleen: raak je je toestel kwijt, dan sta je buiten. Schrijf je herstelcodes op papier en leg ze in je noodpakket.', naar: '/als-er-is-ingebroken#noodpakket', naarTekst: 'Maak je noodpakket' };
      return { tekst: 'Bovenaan de ladder. Help nu iemand anders met de zijne.', naar: '/voor-de-mensen-om-je-heen', naarTekst: 'Iemand anders helpen' };
    }

    // wie lager staat en geen herstelcodes heeft, hoort dat ook te horen:
    // anders stel je drie vragen en doe je met de derde niets
    function noodzin(nood: string, t: number) {
      return nood === 'nee' && t <= 5
        ? ' Let op: raak je vandaag je telefoon kwijt, dan kom je er niet meer in. Schrijf je herstelcodes op papier.'
        : '';
    }

    function toon() {
      const r = trede();
      const uit = s.querySelector<HTMLElement>('[data-uitslag]')!;
      uit.hidden = !r;
      if (!r) return;
      s.querySelector('[data-bol]')!.textContent = String(r.t).padStart(2, '0');
      s.querySelector('[data-titel]')!.textContent = tredeInfo(r.t)!.titel;
      const a = advies(r);
      s.querySelector('[data-advies]')!.textContent = a.tekst + noodzin(r.nood, r.t);
      s.querySelector('[data-link]')!.setAttribute('href', `#trede-${r.t}`);
      const volgende = s.querySelector<HTMLElement>('[data-volgende]')!;
      volgende.hidden = r.t >= 8;
      volgende.setAttribute('href', `#trede-${Math.min(r.t + 1, 8)}`);
      const stap = s.querySelector<HTMLElement>('[data-stap]')!;
      stap.setAttribute('href', a.naar);
      stap.textContent = a.naarTekst + ' →';
    }
    s.querySelectorAll('input').forEach((i) => i.addEventListener('change', toon));
  });
</script>

<style>
  .tredecheck { margin: 2rem 0 2.5rem; padding: 1.25rem 1.4rem; border: var(--lijndikte) solid var(--lijn-sterk); border-radius: var(--radius); }
  .tredecheck h2 { margin: 0 0 0.25rem; font-size: clamp(1.4rem, 3.4vw, 1.8rem); }
  .uitleg { color: var(--inkt-zacht); font-size: 0.97rem; margin-bottom: 1rem; }
  fieldset { border: 0; padding: 0; margin: 0 0 1.1rem; }
  legend { font-weight: 700; margin-bottom: 0.4rem; padding: 0; }
  label { display: flex; align-items: center; gap: 0.6rem; padding: 0.35rem 0.4rem; border-radius: var(--radius); cursor: pointer; font-size: 1rem; }
  label:hover { background: var(--papier-2); }
  input { width: 1.25rem; height: 1.25rem; accent-color: var(--rood); flex: none; margin: 0; }
  .uitslag { margin-top: 1rem; padding-top: 1rem; border-top: var(--lijndikte-dun) solid var(--lijn); }
  .uitslag[hidden] { display: none; }
  .trede { display: flex; align-items: center; gap: 0.75rem; font-family: var(--kop); font-size: 1.3rem; margin: 0 0 0.5rem; }
  .uitslag p:last-child { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; }
</style>
