---
/**
 * Eén plek van de plattegrond. Eerst een echte kop met alleen het onderwerp ("Wifi en
 * router"), zodat wie de koppen langsloopt of een schermlezer per kop laat springen, het
 * woord vindt waar hij naar zoekt. Een kop in een uitklapknop telt voor een schermlezer
 * niet als kop; daarom staat hij erboven, niet erin.
 *
 * Daaronder een uitklapper. Dicht zie je al het antwoord: wat je doet. Open staan eerst,
 * per maildienst of toestel, de knoppen zelf (`keuzes`), dan waarom, en waar je het stap
 * voor stap doet.
 *
 * Het anker (`kamer.anker`) blijft de id van de uitklapper, zodat links als
 * /plattegrond#de-voordeur-je-e-mail vanuit het fort en het woordenboek blijven werken: het
 * script klapt die kamer dan open. Een link naar een keuze (#google-account) klapt de kamer
 * en die keuze open.
 *
 * Kleurt de huischeck of een vinkje de plek, dan staat er ook in woorden hoe het ervoor
 * staat ("Staat open", "Op slot"): kleur alleen is voor wie slecht kleuren ziet geen antwoord.
 */
import { kamer } from '../data/kamers.js';
import KamerIcoon from './KamerIcoon.astro';
import NaarDoen from './NaarDoen.astro';
interface Ook { href: string; tekst: string; waar: string }
interface Props { id: string; ook?: Ook[] }
const k = kamer(Astro.props.id);
if (!k) throw new Error(`Onbekende kamer: ${Astro.props.id}`);
const { ook = [] } = Astro.props;
---
<section class="kamer-blok" data-kamer-blok={k.id} aria-labelledby={`kop-${k.id}`}>
  <h2 class="kamer-kop" id={`kop-${k.id}`}><KamerIcoon id={k.id} /><span class="onderwerp">{k.onderwerp}</span></h2>
  <details class="kamer" id={k.anker} data-kamer-uitleg={k.id}>
    <summary>
      <span class="kop-tekst">
        <span class="zin">{k.doe}</span>
        <span class="hoe">Zo doe je het</span>
      </span>
      <span class="stand">
        <span class="lampje" aria-hidden="true"></span>
        <span class="toestand" data-toestand-tekst></span>
      </span>
    </summary>
    <div class="uitleg">
      {k.keuzes && (
        <div class="keuzes" data-keuzes>
          <h3 class="keuze-vraag">{k.keuzeVraag}</h3>
          {(k.keuzeVoor ?? []).map((zin) => <p class="keuze-voor">{zin}</p>)}
          {k.keuzes.map((c) => (
            <details class="keuze" id={c.id} data-keuze={c.id}>
              <summary>{c.kop}</summary>
              <ol>{c.stappen.map((st) => <li>{st}</li>)}</ol>
            </details>
          ))}
          {(k.keuzeNa ?? []).map((zin) => <p>{zin}</p>)}
        </div>
      )}
      <p class="waarom"><strong>Waarom?</strong> {k.zin}</p>
      <slot />
      <NaarDoen stappen={k.stappen} ook={ook} />
    </div>
  </details>
</section>

<script>
  import { lees } from '../lib/opslag.js';
  import { toestandPerKamer } from '../lib/toestand.js';

  const kamers = Array.from(document.querySelectorAll<HTMLDetailsElement>('details[data-kamer-uitleg]'));
  const WOORD: Record<string, string> = { open: 'Staat open', dicht: 'Op slot' };

  /**
   * Een link naar een kamer (van het fort, het woordenboek of de kaart) klapt hem open.
   * Een link naar een keuze erin (#google-account) klapt ook die keuze open.
   */
  function openVanuitAdres() {
    const id = decodeURIComponent(location.hash.slice(1));
    const doel = id ? document.getElementById(id) : null;
    const kamer = doel?.closest<HTMLDetailsElement>('details[data-kamer-uitleg]');
    if (!doel || !kamer) return;
    kamer.open = true;
    if (doel instanceof HTMLDetailsElement) doel.open = true;
    doel.scrollIntoView({ block: 'start' });
  }

  function kleur(data = lees()) {
    const toestand = toestandPerKamer(data);
    kamers.forEach((d) => {
      const t = toestand[d.dataset.kamerUitleg!];
      d.dataset.toestand = t;
      d.querySelector<HTMLElement>('[data-toestand-tekst]')!.textContent = WOORD[t] ?? '';
    });
  }

  if (kamers.length) {
    openVanuitAdres();
    window.addEventListener('hashchange', openVanuitAdres);
    kleur();
    window.addEventListener('jdh:gewijzigd', (e: Event) => kleur((e as CustomEvent).detail));
    // op papier bestaat geen uitklapper: alles open, en daarna terug zoals het was
    let waren: boolean[] = [];
    window.addEventListener('beforeprint', () => { waren = kamers.map((d) => d.open); kamers.forEach((d) => { d.open = true; }); });
    window.addEventListener('afterprint', () => { kamers.forEach((d, i) => { d.open = waren[i] ?? false; }); });
  }
</script>

<style>
  .kamer-blok { scroll-margin-top: 5rem; }
  /* de kop: kort, met het icoon ervoor; de lijn erboven scheidt de plekken */
  .kamer-kop { display: flex; align-items: center; gap: 0.75rem; margin: 1.75rem 0 0; padding-top: 0.9rem; font-size: 1.5rem; line-height: 1.25; }
  .kamer-kop :global(.kamer-icoon) { flex: none; float: none; margin: 0; }
  .kamer-kop :global(.kamer-icoon svg) { width: 44px; height: 44px; display: block; }
  /* de kop staat er al boven: bij een link naar de kamer moet die kop in beeld blijven */
  .kamer { scroll-margin-top: 9rem; border-bottom: var(--lijndikte-dun) solid var(--lijn); }
  .kamer > summary { display: flex; align-items: flex-start; gap: 1rem; padding: 0.6rem 0.25rem 0.9rem; cursor: pointer; list-style: none; }
  .kamer > summary::-webkit-details-marker { display: none; }
  .kamer > summary:hover { background: var(--papier-2); }
  .kamer > summary:hover .hoe { text-decoration-thickness: 3px; }
  .kamer > summary:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
  .kop-tekst { flex: 1; min-width: 0; }
  .zin { display: block; font-size: 1.05rem; line-height: 1.45; }
  /* zoals het details-blok van GOV.UK: een onderstreepte regel zegt dat hier meer achter zit */
  .hoe { display: inline-block; margin-top: 0.35rem; color: var(--rood); font-weight: 700; text-decoration: underline; text-underline-offset: 0.15em; }
  .hoe::before { content: "▸"; display: inline-block; margin-right: 0.35rem; transition: transform 0.15s ease; }
  .kamer[open] > summary .hoe::before { transform: rotate(90deg); }
  .stand { flex: none; display: flex; flex-direction: column; align-items: flex-end; gap: 0.3rem; margin-top: 0.2rem; }
  .lampje { margin-top: 0; }
  .toestand { font-family: var(--kop); font-size: var(--tekst-m); font-weight: 700; white-space: nowrap; }
  .toestand:empty { display: none; }
  /* een leeg rondje lijkt een aanvinkhokje: pas tonen als de huischeck er een kleur aan geeft */
  .kamer:not([data-toestand="open"]):not([data-toestand="dicht"]) .lampje { display: none; }
  .uitleg { padding: 0.25rem 0 1.25rem 0.25rem; }
  .waarom { margin-top: 0.25rem; }
  /* per maildienst of toestel: kies je eigen pad, de rest blijft dicht */
  .keuzes { margin: 0.5rem 0 1.25rem; }
  .keuze-vraag { margin: 0 0 0.5rem; padding: 0; border: 0; font-size: 1.15rem; }
  .keuze-voor { margin: 0 0 0.5rem; }
  .keuze { border-left: 4px solid var(--lijn-sterk); margin: 0.4rem 0; padding: 0 0 0 0.9rem; }
  .keuze > summary { cursor: pointer; padding: 0.45rem 0; font-weight: 700; color: var(--rood); text-decoration: underline; text-underline-offset: 0.15em; min-block-size: 44px; display: flex; align-items: center; }
  .keuze > summary:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
  .keuze[open] > summary { text-decoration-thickness: 3px; }
  .keuze ol { margin: 0.25rem 0 0.75rem; }
  .keuze li { margin: 0.3rem 0; }
  @media (max-width: 40rem) {
    .kamer-kop { font-size: 1.3rem; }
    .kamer-kop :global(.kamer-icoon svg) { width: 36px; height: 36px; }
  }
  @media (prefers-reduced-motion: reduce) { .hoe::before { transition: none; } }
</style>
