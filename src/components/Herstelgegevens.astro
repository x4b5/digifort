---
/**
 * Waar je per dienst ziet welk telefoonnummer en welk extra e-mailadres bij je
 * account staan. De testpersoon kreeg eerst alleen "zoek daar naar herstel" en
 * wist niet hoe je op een pagina zoekt, of waar het nummer stond.
 */
import Optie from './Optie.astro';
import ZoekOpPagina from './ZoekOpPagina.astro';
---
<p>Tik op je e-mail:</p>
<Optie titel="@gmail.com (Google)">
  <ol>
    <li>Ga naar myaccount.google.com en log in.</li>
    <li>Typ "herstel" in de zoekbalk bovenaan. Je ziet een telefoonnummer en een e-mailadres voor herstel.</li>
    <li>Kies ze één voor één. Klopt het niet? Haal het weg, en vul je eigen gegevens in.</li>
  </ol>
</Optie>
<Optie titel="@outlook.com, @hotmail.com of @live.nl (Microsoft)">
  <ol>
    <li>Ga naar account.microsoft.com en log in.</li>
    <li>Kies Beveiliging.</li>
    <li>Zoek op die pagina het woord "aanmeld".<ZoekOpPagina woord="aanmeld" />Klik op de link over hoe je je aanmeldt. Je ziet je telefoonnummers en e-mailadressen.</li>
    <li>Ken je er een niet? Klik erop, en verwijder het.</li>
  </ol>
</Optie>
<Optie titel="@icloud.com of @me.com (Apple)">
  <ol>
    <li>Open Instellingen op je iPhone. Tik bovenaan op je naam.</li>
    <li>Kies Inloggen en beveiliging. Je ziet je e-mailadressen en telefoonnummers.</li>
    <li>Ken je er een niet? Tik op Wijzig bij die lijst. Haal het weg.</li>
  </ol>
</Optie>
<Optie titel="Een adres van je provider of iets anders">
  <p>Log in op de site van je provider. Zoek in de instellingen naar "telefoonnummer". Vind je het niet? Bel je provider.</p>
</Optie>
