---
/** Eén lijntekening per hoofdstuk, in dezelfde stijl als de kamericonen.
    Het vlak eronder volgt dezelfde kleurregel als de tekening zelf:
    rood waar het misgaat, groen waar je iets regelt, neutraal bij naslag. */
const SOORT: Record<string, string> = {
  'inbrekers-van-nu': 'gevaar',
  'inbrekers-van-morgen': 'gevaar',
  'de-storm-om-het-huis': 'gevaar',
  'als-er-is-ingebroken': 'gevaar',
  huischeck: 'doen',
  'aan-de-slag': 'doen',
  'een-avond': 'doen',
  'van-geheim-woord-naar-zegelring': 'doen',
  onderhoud: 'doen',
  'het-fort-afbouwen': 'doen',
  'voor-de-mensen-om-je-heen': 'doen',
};
const { slug, maat = 48 } = Astro.props;
const soort = SOORT[slug] ?? 'naslag';
---
<span class={`hicoon hicoon-${soort}`} style={`--icoon: ${maat}px`} aria-hidden="true">
  <svg viewBox="0 0 64 64" width={maat} height={maat}>
    {slug === 'huischeck' && <g><rect class="tek" x="14" y="12" width="36" height="44" rx="3" /><rect class="tek-dun" x="24" y="8" width="16" height="8" rx="2" /><path class="tek-groen" d="M21 30 l5 5 l9 -9" /><path class="tek-groen" d="M21 45 l5 5 l9 -9" /><path class="tek-dun" d="M38 29 H44 M38 44 H44" /></g>}
    {slug === 'plattegrond' && <g><path class="tek" d="M8 30 L32 10 L56 30" /><path class="tek" d="M12 27 V56 H52 V27" /><path class="tek-dun" d="M12 42 H52 M32 42 V56 M32 27 V42" /><rect class="tek-vul" x="20" y="48" width="5" height="8" /></g>}
    {slug === 'inbrekers-van-nu' && <g><rect class="tek" x="8" y="10" width="44" height="30" rx="3" /><path class="tek" d="M8 12 L30 28 L52 12" /><path class="tek-rood" d="M44 36 v12 a6 6 0 0 1 -12 0" /><path class="tek-rood" d="M28 48 l4 -4" /></g>}
    {slug === 'inbrekers-van-morgen' && <g><rect class="tek" x="12" y="25" width="40" height="30" rx="4" /><rect class="tek-vul" x="20" y="35" width="8" height="6" /><rect class="tek-vul" x="36" y="35" width="8" height="6" /><path class="tek-dun" d="M23 48 q4 -5 8 0 t8 0 q2 -2.5 4 -2" /><path class="tek" d="M32 25 V15" /><circle class="tek" cx="32" cy="12" r="3" /><path class="tek-dun" d="M10 35 v10 M54 35 v10" /></g>}
    {slug === 'krijg-je-je-geld-terug' && <g><rect class="tek" x="8" y="18" width="48" height="28" rx="3" /><circle class="tek-dun" cx="32" cy="32" r="7" /><path class="tek-rood" d="M44 52 a16 16 0 0 1 -24 0" /><path class="tek-rood" d="M20 44 v8 h8" /></g>}
    {slug === 'de-storm-om-het-huis' && <g><path class="tek" d="M12 26 a10 10 0 0 1 18 -8 a12 12 0 0 1 22 3 a8 8 0 0 1 -2 15 H18 a8 8 0 0 1 -6 -10 z" /><path class="tek-rood" d="M32 36 l-6 8 h8 l-6 10" /><path class="tek-dun" d="M16 42 l-3 6 M46 42 l-3 6" /></g>}
    {slug === 'aan-de-slag' && <g><rect class="tek" x="10" y="12" width="20" height="42" rx="2" /><circle class="tek-dun" cx="26" cy="34" r="1.6" /><path class="tek-groen" d="M14 30 l4 4 l8 -9" /><rect class="tek" x="36" y="12" width="20" height="42" rx="2" /><circle class="tek-dun" cx="40" cy="34" r="1.6" /><path class="tek-rood" d="M47 24 V42" /><path class="tek" d="M8 54 H56" /></g>}
    {slug === 'een-avond' && <g><circle class="tek" cx="32" cy="34" r="22" /><path class="tek" d="M32 34 V20" /><path class="tek" d="M32 34 l12 6" /><path class="tek-dun" d="M24 8 h16" /></g>}
    {slug === 'van-geheim-woord-naar-zegelring' && <g><path class="tek" d="M16 56 V8 M48 56 V8" /><path class="tek-groen" d="M16 17 H48" /><path class="tek-dun" d="M16 28 H48 M16 39 H48" /><path class="tek-rood" d="M16 50 H48" /></g>}
    {slug === 'het-fort-afbouwen' && <g><path class="tek" d="M10 56 V22 H18 V28 H26 V22 H38 V28 H46 V22 H54 V56 Z" /><path class="tek-dun" d="M10 36 H54" /><path class="tek-groen" d="M26 56 V46 a6 6 0 0 1 12 0 V56" /></g>}
    {slug === 'onderhoud' && <g><path class="tek" d="M12 18 H52" /><path class="tek" d="M26 18 V13 H38 V18" /><path class="tek" d="M17 22 L20 52 H44 L47 22" /><path class="tek-dun" d="M26 28 V46 M38 28 V46" /></g>}
    {slug === 'als-er-is-ingebroken' && <g><path class="tek" d="M18 40 V28 a14 14 0 0 1 28 0 v12 l6 6 H12 z" /><path class="tek" d="M26 50 a6 6 0 0 0 12 0" /><path class="tek-rood" d="M32 8 v6 M10 20 l5 3 M54 20 l-5 3" /></g>}
    {slug === 'voor-de-mensen-om-je-heen' && <g><circle class="tek" cx="32" cy="18" r="7" /><path class="tek" d="M20 46 v-8 a12 12 0 0 1 24 0 v8" /><circle class="tek-dun" cx="16" cy="24" r="5" /><path class="tek-dun" d="M8 46 v-6 a8 8 0 0 1 12 -7" /><circle class="tek-dun" cx="48" cy="24" r="5" /><path class="tek-dun" d="M56 46 v-6 a8 8 0 0 0 -12 -7" /><path class="tek" d="M10 54 H54" /></g>}
    {slug === 'woordenboek' && <g><path class="tek" d="M32 16 C 26 10, 14 10, 8 14 V50 C 14 46, 26 46, 32 52 C 38 46, 50 46, 56 50 V14 C 50 10, 38 10, 32 16 Z" /><path class="tek" d="M32 16 V52" /><path class="tek-dun" d="M13 26 H27 M13 32 H27 M13 38 H25" /><path class="tek-dun" d="M37 26 H51 M37 32 H51 M39 38 H51" /></g>}
    {slug === 'kleine-lettertjes' && <g><rect class="tek" x="10" y="8" width="32" height="46" rx="3" /><path class="tek-dun" d="M16 18 H36 M16 24 H36 M16 30 H32 M16 36 H36 M16 42 H28" /><circle class="tek" cx="42" cy="40" r="12" /><path class="tek" d="M51 49 L58 56" /></g>}
    {slug === 'over' && <g><path class="tek" d="M10 12 h44 v30 h-22 l-12 10 v-10 h-10 z" /><circle class="tek-vul-inkt" cx="32" cy="20" r="2.5" /><path class="tek" d="M32 26 V36" /></g>}
  </svg>
</span>
<style>
  .hicoon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: calc(var(--icoon) * 1.45);
    height: calc(var(--icoon) * 1.45);
    border-radius: calc(var(--icoon) * 0.2);
    background: var(--papier-2);
    line-height: 0;
  }
  .hicoon-gevaar { background: var(--rood-licht); }
  .hicoon-doen { background: var(--groen-licht); }
  .hicoon svg { display: block; }
</style>
