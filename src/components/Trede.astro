---
/** Eén trede van de ladder: nummer, titel, en de inhoud in de slot. */
const { nr, titel, soort } = Astro.props;
---
<section class="trede" id={`trede-${nr}`}>
  <p class="trede-nr"><span class:list={['bol', soort]}>{String(nr).padStart(2, '0')}</span> <span class="soort">{soort === 'hebben' ? 'iets wat je hebt' : 'iets wat je weet'}</span></p>
  <h2>{titel}</h2>
  <slot />
</section>
<style>
  .trede { margin-top: 3rem; }
  .trede h2 { border-top: 0; padding-top: 0; margin-top: 0.4rem; }
  .trede-nr { display: flex; align-items: center; gap: 0.75rem; margin: 0; font-family: var(--kop); font-size: 0.9rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--inkt-zacht); }
  .bol { display: inline-flex; align-items: center; justify-content: center; width: 2.6rem; height: 2.6rem; border-radius: 50%; color: #fff; font-size: 1.1rem; letter-spacing: 0; background: var(--rood); }
  .bol.hebben { background: var(--groen); }
</style>
