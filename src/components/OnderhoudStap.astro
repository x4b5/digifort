---
/**
 * Eén stap van de onderhoudsbeurt (alleen in Onderhoud en opruimen).
 * `id` is dezelfde sleutel als in LIJSTEN.onderhoudsbeurt, zodat het vinkje
 * in hetzelfde laatje landt als bij de gewone afvinklijst.
 */
interface Props { id: string; nr: number; titel: string; minuten: number }
const { id, nr, titel, minuten } = Astro.props;
---
<li class="stap" data-beurt-stap={id} data-minuten={minuten}>
  <p class="plek"><span data-plek>Stap {nr}</span> · ongeveer {minuten} minuten</p>
  <h3>{titel}</h3>
  <div class="hoe"><slot /></div>
  <label class="gedaan">
    <input type="checkbox" data-item={id} />
    <span class="vink" aria-hidden="true"></span>
    <span>Gedaan</span>
  </label>
</li>

<style>
  .stap { margin: 0; padding: 1.1rem 1.1rem 1rem; border: var(--lijndikte) solid var(--lijn-sterk); border-radius: var(--radius); background: var(--papier); }
  .stap + .stap { margin-top: 1rem; }
  .plek { margin: 0; font-family: var(--kop); font-size: 0.85rem; color: var(--rood); letter-spacing: 0.04em; }
  h3 { margin: 0.2rem 0 0.6rem; }
  .hoe :global(p) { margin: 0.5rem 0; }
  .hoe :global(ol), .hoe :global(ul) { margin: 0.5rem 0; }
  .gedaan { display: inline-flex; align-items: center; gap: 0.7rem; min-height: 2.75rem; margin-top: 0.4rem; cursor: pointer; font-weight: 700; }
  .gedaan input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .vink { display: block; width: 2rem; height: 2rem; border: var(--lijndikte) solid var(--lijn-sterk); border-radius: var(--radius); position: relative; background: var(--papier); flex: none; }
  .gedaan input:checked + .vink { background: var(--groen); border-color: var(--groen); }
  .gedaan input:checked + .vink::after { content: ""; position: absolute; left: 0.55rem; top: 0.2rem; width: 0.5rem; height: 1rem; border: solid var(--op-kleur); border-width: 0 4px 4px 0; transform: rotate(45deg); }
  .gedaan input:focus-visible + .vink { outline: 3px solid var(--focus); outline-offset: 3px; }
</style>
