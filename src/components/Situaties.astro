---
/**
 * "Wat is er gebeurd?": drie grote knoppen, elk naar zijn eigen stappenplan.
 * Zo hoeft wie in paniek is niets te lezen wat niet over hem gaat.
 */
const SITUATIES = [
  { tekst: 'Ik ben opgelicht, of er is geld weg', naar: '#opgelicht-of-geld-weg' },
  { tekst: 'Iemand anders zit in mijn account', naar: '#iemand-zit-in-je-account' },
  { tekst: 'Mijn telefoon of laptop is kwijt', naar: '#telefoon-of-laptop-kwijt-het-stappenplan' },
];
---
<ul class="situaties" role="list" aria-label="Wat is er gebeurd?">
  {SITUATIES.map((s) => (
    <li><a href={s.naar}><span>{s.tekst}</span><span class="pijl" aria-hidden="true">↓</span></a></li>
  ))}
</ul>

<style>
  .situaties { list-style: none; margin: 1rem 0 1.5rem; padding: 0; display: grid; gap: 0.6rem; }
  li { margin: 0; }
  a {
    display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    min-height: 3.25rem; padding: 0.6rem 1rem; box-sizing: border-box;
    border: var(--lijndikte-dun) solid var(--inkt); border-radius: var(--radius);
    color: var(--inkt); background: var(--papier); text-decoration: none;
    font-family: var(--kop); font-weight: 700; font-size: 1.1rem; line-height: 1.3;
  }
  a:hover { background: var(--papier-2); text-decoration: underline; }
  a:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
  .pijl { flex: none; font-size: 1.3rem; }
</style>
