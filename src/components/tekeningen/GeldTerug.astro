---
/**
 * Eén vraag splitst het hele hoofdstuk: drukte jij op akkoord, of iemand anders?
 * Het schema is gewone tekst in vakken, geen plaatje: zo is elke letter minstens zo groot
 * als de lopende tekst, groeit hij mee met de leesknop, en leest een schermlezer het
 * in de volgorde van de vraag en de twee antwoorden. Op een smal scherm staan de twee
 * takken onder elkaar.
 */
---
<figure class="beslis" aria-labelledby="beslis-vraag">
  <p class="vraag" id="beslis-vraag">Wie drukte op akkoord?</p>
  <div class="takken">
    <div class="tak tak-groen">
      <p class="wie"><span class="pijl" aria-hidden="true">↓</span> Iemand anders</p>
      <p class="soort">Dit heet een niet-toegestane betaling.</p>
      <p class="uitkomst"><span class="teken" aria-hidden="true">✓</span> De bank betaalt in beginsel terug.</p>
      <p class="voet">Behalve bij grove nalatigheid. Dat is een hoge lat.</p>
    </div>
    <div class="tak tak-rood">
      <p class="wie"><span class="pijl" aria-hidden="true">↓</span> Jij zelf</p>
      <p class="soort">Dit heet een toegestane betaling.</p>
      <p class="uitkomst"><span class="teken" aria-hidden="true">✗</span> Je hebt geen wettelijk recht op je geld.</p>
      <p class="voet">Bij bankhelpdeskfraude betaalt de bank soms toch. Dat heet coulance. Het is geen recht.</p>
    </div>
  </div>
</figure>

<style>
  /* alle tekst op de maat van de lopende tekst: niets kleiner dan de broodtekst */
  .beslis { margin: 1.75rem 0 2rem; font-size: 1em; }
  .beslis p { margin: 0; }
  .beslis .vraag {
    font-family: var(--kop); font-weight: 700; font-size: 1.15em; text-align: center;
    padding: 0.7rem 1rem; margin: 0 auto 0.75rem; max-width: 24rem;
    border: var(--lijndikte) solid var(--lijn-sterk); border-radius: var(--radius);
  }
  .takken { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  @media (max-width: 34rem) { .takken { grid-template-columns: 1fr; } }
  .tak { display: grid; gap: 0.6rem; align-content: start; padding: 0.9rem 1rem; border-radius: var(--radius); border: var(--lijndikte) solid; }
  .tak-groen { border-color: var(--groen); background: var(--groen-licht); }
  .tak-rood { border-color: var(--rood); background: var(--rood-licht); }
  .wie { font-family: var(--kop); font-weight: 700; }
  .pijl { display: inline-block; width: 1.2em; }
  .uitkomst { font-weight: 700; display: flex; gap: 0.4rem; }
  .teken { flex: none; width: 1.2em; font-weight: 700; }
  .tak-groen .teken { color: var(--groen); }
  .tak-rood .teken { color: var(--rood); }
</style>
