---
/** Een datalek: niet bij jou ingebroken, maar bij de sleutelmaker die een kopie had. */
import Tekening from '../Tekening.astro';
---
<Tekening onderschrift="Bij een datalek wordt niet bij jou ingebroken, maar bij de sleutelmaker. Gebruik je overal dezelfde sleutel? Dan past de gestolen kopie op al je deuren.">
  <svg viewBox="0 0 640 240" role="img" aria-label="Links een winkel met het bord Sleutelmaker en een opengebroken la vol kopieën van sleutels. Eén kopie gaat met drie pijlen naar drie deuren rechts: mail, bank en webwinkel. Alle drie de deuren staan open.">
    <g>
      <rect class="tek" x="20" y="60" width="180" height="150" />
      <path class="tek" d="M10 60 H210" />
      <text class="tek-tekst" x="110" y="48" text-anchor="middle">SLEUTELMAKER</text>
      <rect class="tek-rood" x="50" y="140" width="120" height="50" />
      <path class="tek-rood" d="M50 140 l-10 -14 M170 140 l10 -14" />
      {[0, 1, 2, 3, 4].map((i) => (
        <g>
          <circle class="tek-dun" cx={64 + i * 22} cy={158} r={5} />
          <path class="tek-dun" d={`M${64 + i * 22} 163 v16 h4`} />
        </g>
      ))}
    </g>
    <g>
      <circle class="tek-rood" cx="260" cy="130" r="10" />
      <path class="tek-rood" d="M270 130 H300 M290 130 v8 M298 130 v8" />
      <text class="tek-label" x="280" y="160" text-anchor="middle">gestolen kopie</text>
    </g>
    <path class="tek-dun" d="M310 130 C 360 130, 380 50, 440 50" />
    <path class="tek-dun" d="M310 130 H440" />
    <path class="tek-dun" d="M310 130 C 360 130, 380 210, 440 210" />
    {[
      { y: 50, naam: 'mail' },
      { y: 130, naam: 'bank' },
      { y: 210, naam: 'webwinkel' },
    ].map((d) => (
      <g>
        <path class="tek-dun" d={`M440 ${d.y} m-6 -6 l6 6 l-6 6`} />
        <path class="tek" d={`M460 ${d.y + 28} V${d.y - 28} H500 V${d.y + 28}`} />
        <path class="tek-rood" d={`M460 ${d.y - 28} L480 ${d.y - 18} V${d.y + 28}`} />
        <text class="tek-label" x="530" y={d.y + 5}>{d.naam}</text>
      </g>
    ))}
  </svg>
</Tekening>
