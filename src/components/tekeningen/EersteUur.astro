---
/** Het eerste uur na een inbraak: zes stappen rond een klok. */
import Tekening from '../Tekening.astro';
---
<Tekening onderschrift="Het eerste uur: zes stappen, in deze volgorde. Eerst de bank, dan je e-mail, dan de rest.">
  <svg viewBox="0 0 640 260" role="img" aria-label="Een klok met zes stappen eromheen, met de klok mee: bel je bank, verander je e-mailwachtwoord, log overal uit, controleer je herstelgegevens, waarschuw je contacten, bewaar bewijs.">
    <circle class="tek" cx="320" cy="130" r="60" />
    <path class="tek" d="M320 130 V84 M320 130 L352 148" />
    <circle class="tek-vul" cx="320" cy="130" r="4" />
    {[
      { a: -90, t: '1. bel je bank' },
      { a: -30, t: '2. nieuw e-mailwachtwoord' },
      { a: 30, t: '3. log overal uit' },
      { a: 90, t: '4. check herstelgegevens' },
      { a: 150, t: '5. waarschuw je contacten' },
      { a: 210, t: '6. bewaar bewijs' },
    ].map((s, i) => {
      const r = Math.PI / 180;
      const x = 320 + Math.cos(s.a * r) * 60, y = 130 + Math.sin(s.a * r) * 60;
      const tx = 320 + Math.cos(s.a * r) * 110, ty = 130 + Math.sin(s.a * r) * 95;
      const anchor = Math.cos(s.a * r) > 0.1 ? 'start' : Math.cos(s.a * r) < -0.1 ? 'end' : 'middle';
      return (
        <g>
          <circle class={i === 0 ? 'tek-vul' : 'tek-vul-inkt'} cx={x} cy={y} r="6" />
          <text class="tek-label" x={tx} y={ty + 4} text-anchor={anchor}>{s.t}</text>
        </g>
      );
    })}
  </svg>
</Tekening>
