---
/** Ladder, tekening 12. Overgezet uit de oude pagina; kleur: rood = iets wat je weet, groen = iets wat je hebt. */
---
<figure class="tekening ladder-tek">
<svg class="mini" viewBox="0 0 400 100" role="img" aria-label="Drie dingen naast elkaar: een sleutel aan de sleutelbos, een tweede sleutel in de la, en de herstelcodes op papier.">
        <circle class="hl" cx="30" cy="48" r="11"></circle>
        <rect class="obj" x="42" y="38" width="72" height="20" rx="3"></rect>
        <circle class="hl" cx="98" cy="48" r="6"></circle>
        <text class="cap" x="66" y="86" text-anchor="middle">sleutelbos</text>
        <rect class="ln" x="146" y="26" width="104" height="44" rx="3" stroke-dasharray="4 4"></rect>
        <rect class="obj" x="158" y="38" width="72" height="20" rx="3"></rect>
        <circle class="hl" cx="214" cy="48" r="6"></circle>
        <text class="cap" x="198" y="86" text-anchor="middle">de la</text>
        <rect class="obj" x="296" y="20" width="56" height="56" rx="2"></rect>
        <g class="hl" opacity="0.8">
          <line x1="306" y1="34" x2="342" y2="34"></line>
          <line x1="306" y1="44" x2="342" y2="44"></line>
          <line x1="306" y1="54" x2="330" y2="54"></line>
          <line x1="306" y1="64" x2="338" y2="64"></line>
        </g>
        <text class="cap" x="324" y="86" text-anchor="middle">op papier</text>
      </svg>
</figure>
