---
/** Ladder, tekening 8. Overgezet uit de oude pagina; kleur: rood = iets wat je weet, groen = iets wat je hebt. */
---
<figure class="tekening ladder-tek">
<svg class="mini" viewBox="0 0 400 100" role="img" aria-label="Een willekeurig zinnetje gaat door onze ring en komt eruit als een zegel waarin het webadres proton.me mee is gedrukt.">
        <rect class="obj" x="14" y="32" width="72" height="34" rx="3"></rect>
        <text x="50" y="54" text-anchor="middle" font-size="11">a7f2c9…</text>
        <text class="cap" x="50" y="84" text-anchor="middle">het zinnetje</text>
        <line class="ln" x1="94" y1="49" x2="136" y2="49"></line>
        <path class="arw" d="M136,45 L144,49 L136,53 z"></path>
        <circle class="hl" cx="176" cy="49" r="19"></circle>
        <circle class="ln" cx="176" cy="49" r="9"></circle>
        <text class="cap" x="176" y="88" text-anchor="middle">onze ring</text>
        <line class="ln" x1="204" y1="49" x2="240" y2="49"></line>
        <path class="arw" d="M240,45 L248,49 L240,53 z"></path>
        <rect class="obj" x="256" y="28" width="128" height="42" rx="3"></rect>
        <text x="294" y="54" text-anchor="middle" font-size="11">a7f2c9…</text>
        <circle class="hl" cx="350" cy="49" r="20"></circle>
        <text class="tint" x="350" y="52" text-anchor="middle" font-size="6.5">proton.me</text>
        <text class="cap" x="320" y="88" text-anchor="middle">gezegeld, mét het adres</text>
      </svg>
</figure>
<style>
  .ladder-tek :global(text) { font-family: var(--tekst); }
  .ladder-tek :global(svg) { max-width: 40rem; }
</style>
