---
/** Ladder, tekening 9. Overgezet uit de oude pagina; kleur: rood = iets wat je weet, groen = iets wat je hebt. */
---
<figure class="tekening ladder-tek">
<svg viewBox="0 0 620 278" role="img" aria-label="Dezelfde nepsite, twee uitkomsten: een code wordt doorgegeven aan de echte site, een zegel verlaat onze hand niet omdat het webadres niet klopt.">
          <defs>
            <marker id="p2-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
              <path d="M0,0 L8,4 L0,8 z" fill="currentColor"></path>
            </marker>
            <marker id="p2-faint" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
              <path d="M0,0 L8,4 L0,8 z" fill="currentColor" opacity="0.3"></path>
            </marker>
          </defs>

          <text x="14" y="22" font-size="10.5" class="t-label" fill="currentColor" opacity="0.7">MET EEN CODE UIT EEN APP</text>
          <g fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.5">
            <rect x="14" y="46" width="118" height="44" rx="2"></rect>
            <rect x="248" y="46" width="118" height="44" rx="2"></rect>
            <rect x="482" y="46" width="118" height="44" rx="2"></rect>
          </g>
          <g fill="currentColor" font-size="12.5" text-anchor="middle">
            <text x="73" y="73">jij</text>
            <text x="307" y="73">de nepsite</text>
            <text x="541" y="73" class="alleen-breed">de echte site</text>
            <text x="541" y="73" class="alleen-smal">echte site</text>
          </g>
          <g stroke="currentColor" stroke-width="1.5" marker-end="url(#p2-arrow)" opacity="0.8">
            <line x1="140" y1="68" x2="238" y2="68"></line>
            <line x1="374" y1="68" x2="472" y2="68"></line>
          </g>
          <g fill="currentColor" font-size="10.5" text-anchor="middle" opacity="0.75">
            <text x="189" y="58">de code</text>
            <text x="423" y="58">doorgegeven</text>
          </g>
          <text x="600" y="112" font-size="11.5" text-anchor="end" style="fill: var(--rood)">de oplichter is binnen</text>

          <line x1="14" y1="146" x2="600" y2="146" stroke="currentColor" stroke-width="1" opacity="0.18"></line>

          <text x="14" y="168" font-size="10.5" class="t-label" fill="currentColor" opacity="0.7">MET EEN SLEUTEL IN ONZE HAND</text>
          <g fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.5">
            <rect x="14" y="198" width="118" height="44" rx="2"></rect>
            <rect x="248" y="198" width="118" height="44" rx="2"></rect>
          </g>
          <rect x="482" y="198" width="118" height="44" rx="2" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.22"></rect>
          <g fill="currentColor" font-size="12.5" text-anchor="middle">
            <text x="73" y="225" class="alleen-breed">jij + sleutel</text>
            <text x="73" y="225" class="alleen-smal">jij</text>
            <text x="307" y="225">de nepsite</text>
          </g>
          <text x="541" y="225" font-size="12.5" text-anchor="middle" fill="currentColor" opacity="0.4" class="alleen-breed">de echte site</text>
          <text x="541" y="225" text-anchor="middle" fill="currentColor" opacity="0.4" class="alleen-smal">echte site</text>
          <line x1="140" y1="220" x2="178" y2="220" stroke="currentColor" stroke-width="1.5" marker-end="url(#p2-arrow)" opacity="0.8"></line>
          <line x1="190" y1="206" x2="190" y2="234" stroke-width="3.5" stroke-linecap="round" style="stroke: var(--groen)"></line>
          <text x="190" y="192" font-size="10.5" text-anchor="middle" style="fill: var(--groen)">het adres klopt niet</text>
          <line x1="374" y1="220" x2="472" y2="220" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 5" marker-end="url(#p2-faint)" opacity="0.3"></line>
          <text x="423" y="210" font-size="10.5" text-anchor="middle" fill="currentColor" opacity="0.45" class="alleen-breed">niets om door te geven</text>
          <text x="423" y="210" text-anchor="middle" fill="currentColor" opacity="0.45" class="alleen-smal">niets</text>
          <text x="600" y="264" font-size="11.5" text-anchor="end" style="fill: var(--groen)">niemand komt binnen</text>
        </svg>
</figure>
