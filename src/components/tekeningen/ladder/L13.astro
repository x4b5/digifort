---
/** Ladder, tekening 13. Overgezet uit de oude pagina; kleur: rood = iets wat je weet, groen = iets wat je hebt. */
---
<figure class="tekening ladder-tek">
<svg viewBox="0 0 620 192" role="img" aria-label="Uit een gehackte server komt van een wachtwoord iets bruikbaars, en van een sleutel alleen een publieke helft waar niemand iets mee kan.">
        <defs>
          <marker id="p4-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M0,0 L8,4 L0,8 z" fill="currentColor"></path>
          </marker>
        </defs>
        <rect x="210" y="14" width="200" height="40" rx="2" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.5"></rect>
        <text x="310" y="39" font-size="12.5" text-anchor="middle" fill="currentColor">de gehackte server</text>
        <g stroke="currentColor" stroke-width="1.5" marker-end="url(#p4-arrow)" opacity="0.55">
          <line x1="268" y1="58" x2="180" y2="84"></line>
          <line x1="352" y1="58" x2="440" y2="84"></line>
        </g>
        <g fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.5">
          <rect x="40" y="92" width="240" height="48" rx="2"></rect>
          <rect x="340" y="92" width="240" height="48" rx="2"></rect>
        </g>
        <g fill="currentColor" font-size="12" text-anchor="middle">
          <text x="160" y="113">de versleutelde afdruk</text>
          <text x="160" y="131">van ons wachtwoord</text>
          <text x="460" y="113">de publieke helft</text>
          <text x="460" y="131">van ons zegel</text>
        </g>
        <text x="160" y="168" font-size="11.5" text-anchor="middle" style="fill: var(--s1)">te kraken, en elders te proberen</text>
        <text x="460" y="168" font-size="11.5" text-anchor="middle" style="fill: var(--s7)">waardeloos voor een inbreker</text>
      </svg>
</figure>
<style>
  .ladder-tek :global(text) { font-family: var(--tekst); }
  .ladder-tek :global(svg) { max-width: 40rem; }
</style>
