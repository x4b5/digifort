---
/** Ladder, tekening 6. Overgezet uit de oude pagina; kleur: rood = iets wat je weet, groen = iets wat je hebt. */
---
<figure class="tekening ladder-tek">
<svg class="mini" viewBox="0 0 400 100" role="img" aria-label="De sms-code bereikt jouw telefoon niet meer, maar komt aan op de telefoon van de oplichter die ons nummer heeft overgenomen.">
        <rect class="obj" x="18" y="34" width="62" height="32" rx="3"></rect>
        <text class="tint" x="49" y="55" text-anchor="middle" font-size="12">123456</text>
        <text class="cap" x="49" y="84" text-anchor="middle">de code</text>
        <path class="ln" d="M88,46 C118,46 128,24 158,24" stroke-dasharray="3 4" opacity="0.25"></path>
        <path class="wrn" d="M88,54 C118,54 128,76 158,76"></path>
        <path class="red" d="M158,72 L166,76 L158,80 z"></path>
        <g class="obj" opacity="0.28">
          <rect x="170" y="4" width="26" height="40" rx="4"></rect>
        </g>
        <text class="cap" x="206" y="28" opacity="0.35">jouw telefoon</text>
        <rect class="wrn" x="170" y="56" width="26" height="40" rx="4"></rect>
        <text class="cap red" x="206" y="80">zijn telefoon — jouw nummer</text>
      </svg>
</figure>
