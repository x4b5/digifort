---
/** Ladder, tekening 4. Overgezet uit de oude pagina; kleur: rood = iets wat je weet, groen = iets wat je hebt. */
---
<figure class="tekening ladder-tek">
<svg class="mini" viewBox="0 0 400 100" role="img" aria-label="Eén sleutel opent een kluis, en de kluis opent drie sloten.">
        <circle class="hl" cx="26" cy="50" r="8"></circle>
        <path class="hl" d="M34,50 H68 M60,50 v6"></path>
        <line class="ln" x1="76" y1="50" x2="124" y2="50"></line>
        <path class="arw" d="M124,46 L132,50 L124,54 z"></path>
        <rect class="obj" x="140" y="22" width="68" height="56" rx="3"></rect>
        <circle class="hl" cx="174" cy="50" r="10"></circle>
        <path class="hl" d="M174,44 v6 h5"></path>
        <text class="cap" x="174" y="94" text-anchor="middle">de kluis</text>
        <g class="ln">
          <line x1="216" y1="50" x2="266" y2="22"></line>
          <line x1="216" y1="50" x2="266" y2="50"></line>
          <line x1="216" y1="50" x2="266" y2="78"></line>
        </g>
        <g class="obj">
          <path d="M276,20 v-4 a6,6 0 0 1 12,0 v4"></path>
          <rect x="272" y="20" width="20" height="14" rx="2"></rect>
          <path d="M276,48 v-4 a6,6 0 0 1 12,0 v4"></path>
          <rect x="272" y="48" width="20" height="14" rx="2"></rect>
          <path d="M276,76 v-4 a6,6 0 0 1 12,0 v4"></path>
          <rect x="272" y="76" width="20" height="14" rx="2"></rect>
        </g>
        <text class="cap" x="302" y="53">alle deuren</text>
      </svg>
</figure>
<style>
  .ladder-tek :global(text) { font-family: var(--tekst); }
  .ladder-tek :global(svg) { max-width: 40rem; }
</style>
