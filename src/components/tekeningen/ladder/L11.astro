---
/** Ladder, tekening 11. Overgezet uit de oude pagina; kleur: rood = iets wat je weet, groen = iets wat je hebt. */
---
<figure class="tekening ladder-tek">
<svg viewBox="0 0 620 252" role="img" aria-label="Links een passkey die vanuit een kluis naar Mac, iPhone en iPad wordt gekopieerd, met de kluis als extra deur; rechts een hardwaresleutel die maar één keer bestaat.">
          <defs>
            <marker id="p3-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
              <path d="M0,0 L8,4 L0,8 z" fill="currentColor"></path>
            </marker>
            <marker id="p3-warn" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
              <path d="M0,0 L8,4 L0,8 z" style="fill: var(--rood)"></path>
            </marker>
          </defs>

          <line x1="310" y1="16" x2="310" y2="236" stroke="currentColor" stroke-width="1" opacity="0.18"></line>

          <text x="14" y="22" font-size="10.5" class="t-label" fill="currentColor" opacity="0.7">PASSKEY</text>
          <rect x="20" y="92" width="132" height="46" rx="2" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.5"></rect>
          <text x="86" y="113" font-size="12.5" text-anchor="middle" fill="currentColor">de kluis</text>
          <text x="86" y="129" font-size="10" text-anchor="middle" fill="currentColor" opacity="0.6">Apple · Google · Pass</text>
          <g fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.5">
            <rect x="196" y="58" width="84" height="30" rx="2"></rect>
            <rect x="196" y="100" width="84" height="30" rx="2"></rect>
            <rect x="196" y="142" width="84" height="30" rx="2"></rect>
          </g>
          <g fill="currentColor" font-size="11.5" text-anchor="middle">
            <text x="238" y="78">Mac</text>
            <text x="238" y="120">iPhone</text>
            <text x="238" y="162">iPad</text>
          </g>
          <g stroke="currentColor" stroke-width="1.5" marker-end="url(#p3-arrow)" opacity="0.6">
            <line x1="156" y1="106" x2="188" y2="76"></line>
            <line x1="156" y1="115" x2="188" y2="115"></line>
            <line x1="156" y1="124" x2="188" y2="154"></line>
          </g>
          <line x1="86" y1="204" x2="86" y2="146" stroke-width="1.5" marker-end="url(#p3-warn)" style="stroke: var(--rood)"></line>
          <text x="20" y="226" font-size="10.5" style="fill: var(--rood)">wie de kluis opent, krijgt ze allemaal</text>

          <text x="330" y="22" font-size="10.5" class="t-label" fill="currentColor" opacity="0.7">HARDWARESLEUTEL</text>
          <rect x="396" y="92" width="140" height="46" rx="2" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.5"></rect>
          <text x="466" y="120" font-size="12.5" text-anchor="middle" fill="currentColor">de sleutel</text>
          <g fill="currentColor" font-size="11" text-anchor="middle" opacity="0.75">
            <text x="466" y="172">geen kluis, geen kopie</text>
            <text x="466" y="192">bestaat maar één keer</text>
          </g>
          <text x="466" y="226" font-size="10.5" text-anchor="middle" style="fill: var(--brass)">kwijt is kwijt — vandaar de tweede</text>
        </svg>
</figure>
