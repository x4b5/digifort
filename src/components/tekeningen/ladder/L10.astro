---
/** Ladder, tekening 10. Overgezet uit de oude pagina; kleur: rood = iets wat je weet, groen = iets wat je hebt. */
---
<figure class="tekening ladder-tek">
<svg class="mini" viewBox="0 0 400 100" role="img" aria-label="De sleutel steekt in de USB-poort van de Mac, met een gouden vlakje dat aangeraakt moet worden; rechts dezelfde sleutel die tegen een telefoon wordt gehouden.">
        <rect class="obj" x="14" y="38" width="42" height="24" rx="2"></rect>
        <rect class="ln" x="22" y="45" width="28" height="10" rx="1.5"></rect>
        <rect class="obj" x="54" y="39" width="116" height="22" rx="3"></rect>
        <circle class="ln" cx="66" cy="50" r="4"></circle>
        <circle class="hl" cx="142" cy="50" r="8"></circle>
        <line class="ln" x1="142" y1="16" x2="142" y2="36"></line>
        <path class="arw" d="M138,36 L146,36 L142,43 z"></path>
        <text class="cap" x="142" y="11" text-anchor="middle">aanraken</text>
        <text class="cap" x="92" y="86" text-anchor="middle">in de poort</text>
        <g class="hl" fill="none">
          <path d="M206,40 a10,10 0 0 1 0,20" opacity="0.9"></path>
          <path d="M214,33 a17,17 0 0 1 0,34" opacity="0.6"></path>
          <path d="M222,26 a24,24 0 0 1 0,48" opacity="0.35"></path>
        </g>
        <rect class="obj" x="240" y="22" width="34" height="56" rx="5"></rect>
        <text class="cap" x="240" y="94" text-anchor="middle">of aantikken</text>
      </svg>
</figure>
