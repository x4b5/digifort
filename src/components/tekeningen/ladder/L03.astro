---
/** Ladder, tekening 3. Overgezet uit de oude pagina; kleur: rood = iets wat je weet, groen = iets wat je hebt. */
---
<figure class="tekening ladder-tek">
<svg class="mini" viewBox="0 0 400 100" role="img" aria-label="Drie sleutels die elk naar hun eigen slot gaan; de derde is gestippeld omdat we hem vergeten zijn.">
        <g class="hl">
          <circle cx="40" cy="20" r="7"></circle>
          <path d="M47,20 H82 M74,20 v6"></path>
          <circle cx="40" cy="50" r="7"></circle>
          <path d="M47,50 H82 M70,50 v6 M78,50 v5"></path>
        </g>
        <g class="hl" stroke-dasharray="3 3" opacity="0.4">
          <circle cx="40" cy="80" r="7"></circle>
          <path d="M47,80 H82 M76,80 v6"></path>
        </g>
        <g class="ln">
          <line x1="90" y1="20" x2="266" y2="20"></line>
          <line x1="90" y1="50" x2="266" y2="50"></line>
          <line x1="90" y1="80" x2="266" y2="80" stroke-dasharray="3 4"></line>
        </g>
        <g class="obj">
          <path d="M276,20 v-4 a6,6 0 0 1 12,0 v4"></path>
          <rect x="272" y="20" width="20" height="14" rx="2"></rect>
          <path d="M276,50 v-4 a6,6 0 0 1 12,0 v4"></path>
          <rect x="272" y="50" width="20" height="14" rx="2"></rect>
        </g>
        <g class="obj" opacity="0.3">
          <path d="M276,80 v-4 a6,6 0 0 1 12,0 v4"></path>
          <rect x="272" y="80" width="20" height="14" rx="2"></rect>
        </g>
        <text class="cap red" x="178" y="96" text-anchor="middle">deze ben je vergeten</text>
      </svg>
</figure>
