---
/** Ladder, tekening 1. Overgezet uit de oude pagina; kleur: rood = iets wat je weet, groen = iets wat je hebt. */
---
<figure class="tekening ladder-tek">
<svg viewBox="0 0 620 284" role="img" aria-label="Een trap van acht treden. De onderste vijf beschermen met iets wat we weten, de bovenste drie met iets wat we in handen hebben.">
      <g stroke="currentColor" stroke-width="1.5" opacity="0.25">
        <line x1="96" y1="215" x2="96" y2="196"></line>
        <line x1="162" y1="196" x2="162" y2="177"></line>
        <line x1="228" y1="177" x2="228" y2="158"></line>
        <line x1="294" y1="158" x2="294" y2="139"></line>
        <line x1="360" y1="139" x2="360" y2="120"></line>
        <line x1="426" y1="120" x2="426" y2="101"></line>
        <line x1="492" y1="101" x2="492" y2="82"></line>
      </g>
      <g stroke-width="5" stroke-linecap="round">
        <line x1="34" y1="215" x2="92" y2="215" style="stroke: var(--rood)"></line>
        <line x1="100" y1="196" x2="158" y2="196" style="stroke: var(--rood)"></line>
        <line x1="166" y1="177" x2="224" y2="177" style="stroke: var(--rood)"></line>
        <line x1="232" y1="158" x2="290" y2="158" style="stroke: var(--rood)"></line>
        <line x1="298" y1="139" x2="356" y2="139" style="stroke: var(--rood)"></line>
        <line x1="364" y1="120" x2="422" y2="120" style="stroke: var(--groen)"></line>
        <line x1="430" y1="101" x2="488" y2="101" style="stroke: var(--groen)"></line>
        <line x1="496" y1="82" x2="554" y2="82" style="stroke: var(--groen)"></line>
      </g>
      <g fill="currentColor" font-size="11" text-anchor="middle" opacity="0.7">
        <text x="63" y="206">1</text>
        <text x="129" y="187">2</text>
        <text x="195" y="168">3</text>
        <text x="261" y="149">4</text>
        <text x="327" y="130">5</text>
        <text x="393" y="111">6</text>
        <text x="459" y="92">7</text>
        <text x="525" y="73">8</text>
      </g>
      <line x1="360" y1="60" x2="360" y2="236" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 5" opacity="0.4"></line>
      <text x="368" y="56" font-size="11" style="fill: var(--brass)">hier kantelt het</text>
      <g stroke="currentColor" stroke-width="1.5" fill="none" opacity="0.35">
        <path d="M34,248 v7 H356 v-7"></path>
        <path d="M364,248 v7 H554 v-7"></path>
      </g>
      <g fill="currentColor" font-size="10.5" text-anchor="middle" class="t-label" opacity="0.75">
        <text x="195" y="274">IETS WAT JE WEET</text>
        <text x="459" y="274">IETS WAT JE HEBT</text>
      </g>
    </svg>
</figure>
