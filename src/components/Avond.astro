---
/**
 * Een lijst uit Aan de slag, één stap per scherm: de avond (niveau 1), het weekend (niveau 2)
 * en "Ik wil verder" (niveau 3). Elke "Gedaan" is hetzelfde vinkje als in Aan de slag,
 * dus het fort en de teller in de kop groeien mee.
 *
 * Elke stap heeft dezelfde vorm (zie avond.js): wat je doet, waarom, hoe (per toestel waar
 * dat verschilt), hoe je ziet dat het gelukt is, en wat je doet als het niet lukt.
 * Een stap heeft een eigen adres (#stap-<id>), zodat Aan de slag er direct naar kan linken.
 */
import { LIJSTEN } from '../data/lijsten.js';
import { AVOND, DIENSTEN } from '../data/avond.js';
import HuisEnFort from './HuisEnFort.astro';
import Merk from './Merk.astro';

type Uitklap = { vraag: string, antwoord: string[], dienst?: string };
type Toestel = { naam: string, stappen: string[], diensten?: Uitklap[], uitklap?: Uitklap[] };
type Uitleg = { wat?: string, hoe: string[], dienstEerst?: boolean, zonderDelen?: string[], toestellen?: Toestel[], na?: string[], letOp?: string, uitklap?: Uitklap[], gelukt: string, lukNiet: string[], gereedschap?: string[], klaar: string };
interface Props {
  lijst?: string;
  uitleg?: Record<string, Uitleg>;
  /** bovenregel van het slotscherm, en de zin als alles gedaan is */
  moment?: string;
  alles?: string;
  volgende?: { href: string, tekst: string };
}
const {
  lijst = 'niveau-1',
  uitleg = AVOND,
  moment = 'Klaar voor vanavond',
  alles = 'Alle zes de stappen van niveau 1 zijn gedaan. Daarmee houd je de meeste inbrekers al buiten.',
  volgende = { href: '/een-weekend', tekst: 'Volgende keer: niveau 2 →' },
} = Astro.props;
const stappen = LIJSTEN[lijst].items;
for (const it of stappen) {
  const u = uitleg[it.id];
  if (!u?.gelukt || !u?.lukNiet?.length) throw new Error(`Stap ${it.id} mist "gelukt" of "lukNiet"`);
}
const totaalTijd = stappen.reduce((n, it) => n + (it.tijd ?? 0), 0);
/** vanaf anderhalf uur leest "4 uur" makkelijker dan "240 minuten" */
const duur = (min: number) => (min >= 90 ? `${Math.round(min / 60)} uur` : `${min} minuten`);
/** "[tekst](/pad)" in de uitleg wordt een link; de rest blijft gewone tekst */
const stukjes = (t: string) => t.split(/(\[[^\]]+\]\([^)]+\))/).filter(Boolean).map((s) => {
  const m = s.match(/^\[([^\]]+)\]\(([^)]+)\)$/);
  return m ? { tekst: m[1], href: m[2] } : { tekst: s };
});
/** welk toestel een blok is: daarop filtert de keuze "welke telefoon heb je?" */
const soort = (naam: string) => (/iPhone/.test(naam) ? 'iphone' : /Android/.test(naam) ? 'android' : '');
const heeftTelefoonkeuze = stappen.some((it) => uitleg[it.id].toestellen?.some((t) => soort(t.naam)));
const kiesId = `toestel-${lijst}`;
---
<section class="avond" data-avond data-lijst={lijst} data-alles={alles} data-totaal={stappen.length}>
  <p class="stand" data-stand aria-live="polite">Stap 1 van {stappen.length}{totaalTijd > 0 && ` · ongeveer ${duur(totaalTijd)} in totaal`}</p>

  {heeftTelefoonkeuze && (
    <div class="keuze-blok">
      {/* heb je al eerder gekozen, dan zie je alleen deze regel: de stap staat dan hoger in beeld */}
      <p class="gekozen" data-gekozen hidden>Je telefoon: <strong data-gekozen-naam></strong> <button type="button" class="link" data-wijzig>Wijzig</button></p>
      <fieldset class="toestelkeuze" data-toestelkeuze>
        <legend>Welke telefoon heb je?</legend>
        <div class="keuzes">
          <label><input type="radio" name={kiesId} value="iphone" data-naam="iPhone" /> iPhone</label>
          <label><input type="radio" name={kiesId} value="android" data-naam="Android" /> Android</label>
          <label><input type="radio" name={kiesId} value="" data-naam="allebei" checked /> Laat allebei zien</label>
        </div>
      </fieldset>
    </div>
  )}

  {stappen.map((it, i) => {
    const u = uitleg[it.id];
    const hoe = u.toestellen?.length ? u.hoe : [...u.hoe, ...(u.na ?? [])];
    const na = u.toestellen?.length ? (u.na ?? []) : [];
    const perDienst = u.uitklap?.filter((k) => k.dienst) ?? [];
    return (
      <article class="stap" id={`stap-${it.id}`} data-stap={i} data-item={it.id} data-tijd={it.tijd ?? 0} data-zonder-delen={u.zonderDelen?.join(' ')} aria-labelledby={`kop-${it.id}`} hidden>
        <h2 id={`kop-${it.id}`} tabindex="-1">{it.stap}</h2>
        {u.wat && <p class="wat">{stukjes(u.wat).map((s) => s.href ? <a href={s.href}>{s.tekst}</a> : s.tekst)}</p>}

        {/* één zin is geen lijstje: dan gewoon een alinea */}
        {hoe.length === 1 && <p class="een-zin">{stukjes(hoe[0]).map((s) => s.href ? <a href={s.href}>{s.tekst}</a> : s.tekst)}</p>}
        {hoe.length > 1 && <ol class="hoe">{hoe.map((h) => <li>{stukjes(h).map((s) => s.href ? <a href={s.href}>{s.tekst}</a> : s.tekst)}</li>)}</ol>}

        {/* de keuze van je maildienst: één keer per stap. Bij `dienstEerst` staat hij vóór de delen,
            want misschien hoef je ze niet te doen; anders bij de blokken per maildienst */}
        {(perDienst.length > 0 || u.toestellen?.some((t) => t.diensten)) && (
          <div class="keuze-blok" data-dienstblok>
            <p class="gekozen" data-gekozen hidden>Je maildienst: <strong data-gekozen-naam></strong> <button type="button" class="link" data-wijzig>Wijzig</button></p>
            {/* zonder JavaScript blijft de keuze weg en zie je alle blokken */}
            <fieldset class="toestelkeuze dienstkeuze" data-dienstkeuze hidden>
              <legend>Welke maildienst heb je?</legend>
              <p class="toestel-hint">Kijk naar het eind van je e-mailadres, na de @.</p>
              <div class="keuzes onder">
                {DIENSTEN.map((d) => (
                  <label><input type="radio" name={`dienst-${it.id}`} value={d.id} data-naam={d.naam} /> <span><strong>{d.naam}</strong>{d.adres && <span class="adres"> {d.adres}</span>}</span></label>
                ))}
                <label><input type="radio" name={`dienst-${it.id}`} value="" data-naam="alles" checked /> Laat alles zien</label>
              </div>
            </fieldset>
          </div>
        )}
        {perDienst.length > 0 && (
          <div class="diensten" data-diensten data-zonder-terugval={u.dienstEerst ? '' : undefined}>
            {perDienst.map((k) => (
              <details class="uitklap" data-dienst={k.dienst}>
                <summary><span class="pijl" aria-hidden="true">›</span> {k.vraag}</summary>
                <div class="uitklap-tekst">
                  {k.antwoord.length === 1
                    ? <p>{stukjes(k.antwoord[0]).map((s) => s.href ? <a href={s.href}>{s.tekst}</a> : s.tekst)}</p>
                    : <ol class="hoe">{k.antwoord.map((h) => <li>{stukjes(h).map((s) => s.href ? <a href={s.href}>{s.tekst}</a> : s.tekst)}</li>)}</ol>}
                </div>
              </details>
            ))}
          </div>
        )}
        {u.toestellen?.map((t) => (
          <div class="toestel" data-soort={soort(t.naam)} data-deel={u.zonderDelen ? '' : undefined}>
            <h3 class="deel-kop">{t.naam}</h3>
            {/* een deel kan per maildienst verschillen: dan staan die blokken hier, in het deel zelf */}
            {t.diensten && (
              <div class="diensten" data-diensten>
                {t.diensten.map((k) => (
                  <details class="uitklap" data-dienst={k.dienst}>
                    <summary><span class="pijl" aria-hidden="true">›</span> {k.vraag}</summary>
                    <div class="uitklap-tekst">
                      <ol class="hoe">{k.antwoord.map((h) => <li>{stukjes(h).map((s) => s.href ? <a href={s.href}>{s.tekst}</a> : s.tekst)}</li>)}</ol>
                    </div>
                  </details>
                ))}
              </div>
            )}
            {/* keuzes binnen een deel (zoals: de code staat op je computer, of op je telefoon) komen vóór wat daarna voor iedereen geldt */}
            {t.uitklap?.map((k) => (
              <details class="uitklap">
                <summary><span class="pijl" aria-hidden="true">›</span> {k.vraag}</summary>
                <div class="uitklap-tekst">
                  <ol class="hoe">{k.antwoord.map((h) => <li>{stukjes(h).map((s) => s.href ? <a href={s.href}>{s.tekst}</a> : s.tekst)}</li>)}</ol>
                </div>
              </details>
            ))}
            {t.stappen.length > 0 && <ol class="hoe">{t.stappen.map((h) => <li>{stukjes(h).map((s) => s.href ? <a href={s.href}>{s.tekst}</a> : s.tekst)}</li>)}</ol>}
          </div>
        ))}
        {na.length > 0 && (
          <div class="toestel">
            <h3 class="deel-kop">Daarna</h3>
            {na.length === 1
              ? <p>{stukjes(na[0]).map((s) => s.href ? <a href={s.href}>{s.tekst}</a> : s.tekst)}</p>
              : <ol class="hoe">{na.map((h) => <li>{stukjes(h).map((s) => s.href ? <a href={s.href}>{s.tekst}</a> : s.tekst)}</li>)}</ol>}
          </div>
        )}
        {u.uitklap?.filter((k) => !k.dienst).map((k) => (
          <details class="uitklap">
            <summary><span class="pijl" aria-hidden="true">›</span> {k.vraag}</summary>
            <div class="uitklap-tekst">
              {k.antwoord.length === 1
                ? <p>{stukjes(k.antwoord[0]).map((s) => s.href ? <a href={s.href}>{s.tekst}</a> : s.tekst)}</p>
                : <ol class="hoe">{k.antwoord.map((h) => <li>{stukjes(h).map((s) => s.href ? <a href={s.href}>{s.tekst}</a> : s.tekst)}</li>)}</ol>}
            </div>
          </details>
        ))}
        {/* het waarom staat ná de handelingen: zo staat op een telefoon de eerste handeling bovenaan */}
        <p class="waarom"><strong>Waarom?</strong> {it.waarom.replace(/[.]$/, '')}.</p>
        {u.letOp && (
          <div class="let-op">
            <span class="let-op-teken" aria-hidden="true">!</span>
            <p><strong><span class="schermlezer">Let op: </span>{stukjes(u.letOp).map((s) => s.href ? <a href={s.href}>{s.tekst}</a> : s.tekst)}</strong></p>
          </div>
        )}
        {u.gereedschap && u.gereedschap.length > 0 && (
          <p class="gereedschap"><span class="eyebrow zacht klein gereedschap-kop">Gereedschap</span> {u.gereedschap.map((g) => <Merk id={g} maat={22} link />)}</p>
        )}

        {/* het bewijs, met de afvinkknop erin: wat je op je scherm ziet, en dan vink je af */}
        <div class="gelukt">
          <h3 class="kopje">Gelukt als:</h3>
          <p>{u.gelukt}</p>
          <p class="klaar-zin" data-klaar-zin hidden><strong>Afgevinkt.</strong> {u.klaar} <button type="button" class="link" data-toch-niet>Toch niet gedaan</button></p>
          <p class="knoppen"><button type="button" class="knop" data-gedaan>Gelukt, volgende stap →</button></p>
        </div>
        <details class="lukt-niet">
          <summary><span class="pijl" aria-hidden="true">›</span> Lukt het niet?</summary>
          <ul>{u.lukNiet.map((h) => <li>{stukjes(h).map((s) => s.href ? <a href={s.href}>{s.tekst}</a> : s.tekst)}</li>)}</ul>
        </details>
        <p class="knoppen">
          <button type="button" class="knop licht" data-over>Sla over</button>
          {i > 0 && <button type="button" class="knop licht klein" data-terug>← Vorige stap</button>}
        </p>
      </article>
    );
  })}

  <article class="stap einde" data-einde aria-labelledby={`einde-${lijst}`} hidden>
    <p class="eyebrow">{moment}</p>
    <h2 id={`einde-${lijst}`} tabindex="-1" data-einde-kop>Je fort staat</h2>
    <p data-einde-tekst></p>
    <p class="fort-uitleg">De eerste tekening is een huis met open deuren. De tweede is jouw fort: elke stap die je afvinkt, kleurt een deel groen. Je hoeft hier niets te doen.</p>
    <HuisEnFort legenda={false} uitleg="Elk groen deel heb je zelf gebouwd." />
    <p class="knoppen">
      <a class="knop" href={volgende.href}>{volgende.tekst}</a>
      <button type="button" class="knop licht" data-opnieuw>Bekijk de stappen nog eens</button>
    </p>
  </article>
</section>

<script>
  import { lees, zetVinkje } from '../lib/opslag.js';

  // welke telefoon je hebt, onthoudt alleen deze browser; zonder opslag zie je gewoon allebei
  const TOESTEL = 'jdh:toestel';
  const leesToestel = () => { try { return window.localStorage.getItem(TOESTEL) ?? ''; } catch { return ''; } };
  const bewaarToestel = (w: string) => { try { window.localStorage.setItem(TOESTEL, w); } catch { /* geen opslag */ } };
  // net zo: welke maildienst je hebt
  const DIENST = 'jdh:maildienst';
  const leesDienst = () => { try { return window.localStorage.getItem(DIENST) ?? ''; } catch { return ''; } };
  const bewaarDienst = (w: string) => { try { window.localStorage.setItem(DIENST, w); } catch { /* geen opslag */ } };

  document.querySelectorAll<HTMLElement>('[data-avond]').forEach((s) => {
    const LIJST = s.dataset.lijst!;
    const stappen = Array.from(s.querySelectorAll<HTMLElement>('[data-stap]'));
    const einde = s.querySelector<HTMLElement>('[data-einde]')!;
    const stand = s.querySelector<HTMLElement>('[data-stand]')!;
    const totaal = stappen.length;
    let huidig = 0;

    // wat je op deze pagina afvinkt, onthoudt de pagina ook zelf: zonder opslag (privévenster,
    // geblokkeerde site-gegevens) telt het eindscherm dan toch wat je net hebt gedaan
    const hier: Record<string, boolean> = {};
    let geenOpslag = false;
    const gedaan = () => lees().lijsten[LIJST] ?? {};
    const isGedaan = (i: number) => {
      const id = stappen[i].dataset.item!;
      return Boolean(gedaan()[id] ?? hier[id]);
    };
    const vink = (i: number, aan: boolean) => {
      const id = stappen[i].dataset.item!;
      hier[id] = aan;
      zetVinkje(LIJST, id, aan);
      if (Boolean(gedaan()[id]) !== aan) geenOpslag = true;
    };

    // wat je kiest, bepaalt welke blokken je ziet: je telefoon, en je maildienst.
    // Bij KPN, Ziggo en iCloud vallen de delen van het tweede slot weg (`data-zonder-delen`):
    // daar kijk je eerst na of het kan, en verder niets.
    let toestel = '';
    let dienst = '';
    function toonBlokken() {
      s.querySelectorAll<HTMLElement>('.toestel').forEach((b) => {
        const stap = b.closest<HTMLElement>('[data-stap]');
        const zonder = (stap?.dataset.zonderDelen ?? '').split(' ');
        const andereTelefoon = Boolean(toestel && b.dataset.soort && b.dataset.soort !== toestel);
        const geenDelen = b.hasAttribute('data-deel') && Boolean(dienst) && zonder.includes(dienst);
        b.hidden = andereTelefoon || geenDelen;
      });
      s.querySelectorAll<HTMLElement>('[data-diensten]').forEach((groep) => {
        const blokken = Array.from(groep.querySelectorAll<HTMLDetailsElement>('details[data-dienst]'));
        // een groep met alleen KPN, Ziggo en iCloud valt niet terug: bij Gmail zie je daar dan niets
        const terugval = groep.hasAttribute('data-zonder-terugval') ? undefined : blokken.find((b) => b.dataset.dienst === 'andere');
        const passend = blokken.find((b) => b.dataset.dienst === dienst) ?? terugval;
        blokken.forEach((b) => {
          b.hidden = Boolean(dienst) && b !== passend;
          if (dienst && b === passend) b.open = true;
          // het enige blok, al open: de kop erboven zegt niets nieuws, dus de stappen schuiven op
          b.toggleAttribute('data-alleen', Boolean(dienst) && b === passend);
        });
      });
    }

    // Een keuze die je eerder maakte, klapt in tot één regel met "Wijzig".
    // Zo staat op een telefoon de eerste handeling hoger in beeld.
    function klapIn(blok: HTMLElement, dicht: boolean) {
      const veld = blok.querySelector<HTMLElement>('fieldset')!;
      const regel = blok.querySelector<HTMLElement>('[data-gekozen]')!;
      const gekozen = veld.querySelector<HTMLInputElement>('input:checked');
      regel.querySelector<HTMLElement>('[data-gekozen-naam]')!.textContent = gekozen?.dataset.naam ?? '';
      veld.hidden = dicht;
      regel.hidden = !dicht;
    }
    function koppel(blokken: HTMLElement[], begin: string, kies: (w: string) => void) {
      const radios = blokken.flatMap((b) => Array.from(b.querySelectorAll<HTMLInputElement>('input[type=radio]')));
      const zet = (w: string) => radios.forEach((r) => { r.checked = r.value === w; });
      zet(begin);
      if (!radios.some((r) => r.checked)) zet('');
      blokken.forEach((b) => klapIn(b, Boolean(begin)));
      radios.forEach((r) => r.addEventListener('change', () => {
        zet(r.value);
        kies(r.value);
        // in de andere stappen klapt de keuze meteen in; hier blijft hij open staan
        const hier = r.closest<HTMLElement>('.keuze-blok');
        blokken.forEach((b) => { if (b !== hier) klapIn(b, Boolean(r.value)); });
        toonBlokken();
      }));
      blokken.forEach((b) => b.querySelector('[data-wijzig]')?.addEventListener('click', () => {
        klapIn(b, false);
        b.querySelector<HTMLInputElement>('input:checked')?.focus();
      }));
    }
    const toestelBlok = s.querySelector<HTMLElement>('[data-toestelkeuze]')?.closest<HTMLElement>('.keuze-blok');
    if (toestelBlok) {
      toestel = leesToestel();
      koppel([toestelBlok], toestel, (w) => { toestel = w; bewaarToestel(w); });
    }
    const dienstBlokken = Array.from(s.querySelectorAll<HTMLElement>('[data-dienstblok]'));
    if (dienstBlokken.length) {
      dienst = leesDienst();
      koppel(dienstBlokken, dienst, (w) => { dienst = w; bewaarDienst(w); });
    }
    toonBlokken();

    function toon(i: number, focus = true) {
      huidig = Math.max(0, Math.min(i, totaal));
      stappen.forEach((el, n) => { el.hidden = n !== huidig; });
      einde.hidden = huidig !== totaal;
      const klaar = stappen.filter((_, n) => isGedaan(n)).length;
      if (huidig < totaal) {
        // alleen wat nog open staat, net als in de afvinklijst in Aan de slag;
        // de minuten komen uit data-tijd, niet uit de zichtbare tekst
        const rest = stappen.reduce((n, el, i) => n + (isGedaan(i) ? 0 : Number(el.dataset.tijd)), 0);
        const duur = rest >= 90 ? `${Math.round(rest / 60)} uur` : `${rest} minuten`;
        stand.textContent = `Stap ${huidig + 1} van ${totaal}${rest ? ` · nog ongeveer ${duur}` : ''}`;
        stappen[huidig].querySelector<HTMLElement>('[data-klaar-zin]')!.hidden = !isGedaan(huidig);
      } else {
        stand.textContent = `${klaar} van de ${totaal} stappen gedaan`;
        einde.querySelector<HTMLElement>('[data-einde-kop]')!.textContent = klaar === totaal ? 'Je fort staat' : `Je hebt ${klaar} van de ${totaal} stappen gedaan`;
        einde.querySelector<HTMLElement>('[data-einde-tekst]')!.textContent = (klaar === totaal
          ? s.dataset.alles!
          : 'Wat je oversloeg, staat in Aan de slag klaar voor later.')
          + (geenOpslag ? ' Let op: deze browser onthoudt je vinkjes niet. Na het sluiten zijn ze weg.' : '');
      }
      if (focus) {
        (huidig < totaal ? stappen[huidig] : einde).querySelector<HTMLElement>('h2')?.focus();
        // het adres wijst naar de stap die je ziet, zodat herladen of delen daar weer uitkomt
        const hier = huidig < totaal ? `#${stappen[huidig].id}` : location.pathname + location.search;
        try { history.replaceState(null, '', hier); } catch { /* geen geschiedenis: niet erg */ }
      }
    }

    stappen.forEach((el, i) => {
      el.querySelector('[data-gedaan]')?.addEventListener('click', () => { vink(i, true); toon(i + 1); });
      // wie te snel "gedaan" klikte, kan het hier terugzetten zonder naar Aan de slag te hoeven
      el.querySelector('[data-toch-niet]')?.addEventListener('click', () => { vink(i, false); toon(i, false); });
      el.querySelector('[data-over]')?.addEventListener('click', () => toon(i + 1));
      el.querySelector('[data-terug]')?.addEventListener('click', () => toon(i - 1));
    });
    einde.querySelector('[data-opnieuw]')?.addEventListener('click', () => toon(0));

    // een link als /een-avond#stap-updates opent precies die stap
    const uitAdres = () => stappen.findIndex((el) => `#${el.id}` === decodeURIComponent(location.hash));
    window.addEventListener('hashchange', () => { const n = uitAdres(); if (n !== -1) toon(n); });

    // anders: begin bij de eerste stap die nog niet gedaan is
    const gevraagd = uitAdres();
    const eerste = stappen.findIndex((_, n) => !isGedaan(n));
    // bij het laden geen focus verplaatsen (dat verwart een schermlezer), wel de stap in beeld zetten
    if (gevraagd !== -1) { toon(gevraagd, false); stappen[gevraagd].scrollIntoView({ block: 'start' }); }
    else toon(eerste === -1 ? totaal : eerste, false);
  });
</script>

<style>
  .avond { margin: 1.5rem 0 2rem; }
  /* in de avond is dit de enige regel boven de stap: iets groter dan elders */
  .stand { font-size: var(--tekst-l); margin: 0 0 0.5rem; }

