---
/** "Zo heet dit in het jargon": de vaktermen bij een trede. */
interface Props { items: [string, string][] }
const { items } = Astro.props;
---
<details class="jargon">
  <summary>Zo heet dit in het jargon</summary>
  <dl>
    {items.map(([term, uitleg]) => (<><dt>{term}</dt><dd>{uitleg}</dd></>))}
  </dl>
  <p class="verder">Deze woorden staan hier in het Engels, want zo kom je ze tegen. De Nederlandse uitleg staat in het <a href="/woordenboek">woordenboek</a>.</p>
</details>
<style>
  .jargon { border: var(--lijndikte-dun) solid var(--lijn); border-radius: var(--radius); padding: 0.6rem 1rem; margin: 1.25rem 0; }
  summary { cursor: pointer; font-family: var(--kop); font-weight: 700; }
  /* aanraakscherm: minstens 44px om met een duim te raken (WCAG 2.5.5) */
  @media (pointer: coarse) { summary { padding-block: 0.6rem; } }
  dl { margin: 0.75rem 0 0; }
  dt { font-family: var(--mono); font-size: 0.9rem; color: var(--rood); margin-top: 0.6rem; }
  dd { margin: 0.1rem 0 0; color: var(--inkt-zacht); font-size: 0.95em; }
  .verder { margin: 0.9rem 0 0.2rem; font-size: var(--tekst-m); color: var(--inkt-zacht); }
</style>
