---
import { SITE, datumNL } from '../lib/site.js';
import Europa from './Europa.astro';
const { datum = SITE.laatstNagelopen } = Astro.props;
---
<footer class="voet">
  <div class="wrap voet-rij">
    <p>Deze pagina is voor het laatst nagelopen op <time datetime={datum}>{datumNL(datum)}</time>.</p>
    <p>Gratis, onafhankelijk, zonder reclame en zonder volgers. <a href="/over">Over deze site</a> · <a href="/kleine-lettertjes">De kleine lettertjes</a> · <button type="button" class="link" data-print>Zet mijn lijst op papier</button> · <button type="button" class="link" data-wis>Wis mijn antwoorden</button></p>
    <p class="melding" data-wis-melding role="status"></p>
    <a class="europa" href="/kleine-lettertjes#wat-de-server-ziet"><Europa maat={24} /><span>Gehost in Europa</span></a>
    <!-- getoond op 96 breed: kleiner dan de ware maat (127×19), zodat het logo bescheiden onder de voet staat -->
    <p class="maker"><span>Built by</span>
      <img class="maker-licht" src="/a-bit-odd/a-bit-odd-logo-licht.svg" width="96" height="14" alt="a-bit-odd" />
      <img class="maker-donker" src="/a-bit-odd/a-bit-odd-logo-donker.svg" width="96" height="14" alt="a-bit-odd" />
    </p>
  </div>
</footer>

<style>
  .voet { border-top: var(--lijndikte) solid var(--lijn-sterk); margin-top: 4rem; padding: 1.75rem 0 2.5rem; color: var(--inkt-zacht); font-size: 0.95rem; }
  .voet p { margin: 0 0 0.4rem; }
  .melding:empty { display: none; }
  .europa { display: inline-flex; align-items: center; gap: 0.6rem; margin-top: 0.9rem; color: var(--inkt); font-family: var(--kop); font-weight: 700; text-decoration: none; }
  .europa:hover span { color: var(--rood); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .europa svg { flex: none; }
  .melding { color: var(--inkt); font-weight: 700; }
  .maker { display: flex; flex-direction: column; align-items: center; gap: 0.4rem; margin-top: 2rem; text-align: center; }
  .maker img { width: 96px; max-width: 100%; height: auto; }
  /* de juiste versie per thema; volgt ook de knop die het thema vastzet */
  .maker-donker { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .maker-licht { display: none; }
    :global(:root:not([data-theme="light"])) .maker-donker { display: inline; }
  }
  :global(:root[data-theme="dark"]) .maker-licht { display: none; }
  :global(:root[data-theme="dark"]) .maker-donker { display: inline; }
  .link { background: none; border: 0; padding: 0; font: inherit; color: var(--rood); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 3px; cursor: pointer; }
  /* aanraakscherm: minstens 44px om met een duim te raken (WCAG 2.5.5) */
  @media (pointer: coarse) { .link { min-block-size: 44px; } }
</style>
