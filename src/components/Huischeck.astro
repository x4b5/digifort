---
/** Tien vragen, twee minuten. Het antwoord blijft in je eigen browser. */
import { VRAGEN, BANDEN } from '../data/huischeck.js';
---
<section class="huischeck" data-huischeck>
  <div class="schakel">
    <label><input type="checkbox" data-kind /> Ik doe de check samen met een kind (alleen vraag 1, 3, 6 en 9)</label>
  </div>
  <ol class="vragen">
    {VRAGEN.map((v) => (
      <li data-vraag={v.nr} data-kind-vraag={v.kind ? '1' : undefined}>
        <p class="vraag" id={`vraag-${v.nr}`}><span class="nr">{v.nr}</span> {v.vraag}</p>
        <div class="antwoorden" role="group" aria-labelledby={`vraag-${v.nr}`}>
          <label class="antwoord ja"><input type="radio" name={`v${v.nr}`} value="ja" /><span>Ja</span></label>
          <label class="antwoord nee"><input type="radio" name={`v${v.nr}`} value="nee" /><span>Nee</span></label>
          <label class="antwoord weet"><input type="radio" name={`v${v.nr}`} value="weet-niet" /><span>Weet ik niet</span></label>
        </div>
      </li>
    ))}
  </ol>

  <div class="uitslag" data-uitslag>
    <p class="schermlezer" data-melding aria-live="polite" aria-atomic="true"></p>
    <p class="eyebrow">Je uitslag</p>
    <p class="meter" aria-hidden="true"><span data-meter-vul></span></p>
    <p class="score"><strong data-score>0</strong> <span data-score-tekst>keer ja van de 10</span></p>
    {BANDEN.map((b, i) => (
      <div class="band" data-band={i} hidden>
        <h3>{b.kop}</h3>
        <p>{b.tekst} <a href={b.link}>Ga ernaartoe →</a></p>
      </div>
    ))}
    <div class="open-deuren" data-open-deuren hidden>
      <h3>Jouw bouwvolgorde</h3>
      <p>Elke "nee" of "weet ik niet" is een deur die openstaat. Dit zijn de jouwe, in de volgorde waarin je ze het beste dichtdoet. Vink af wat je doet: het telt meteen mee in <a href="/aan-de-slag">hoofdstuk 4</a> en op je <a href="/#fort">fort</a>.</p>
      <p class="bouw-tijd" data-bouw-tijd></p>
      <ol data-open-lijst></ol>
      <p><a href="/plattegrond">Bekijk ze op de plattegrond →</a></p>
    </div>
    <p class="rest" data-rest>Beantwoord alle vragen voor je uitslag.</p>
  </div>
</section>

<script>
  import { lees, zetAntwoord, zetVinkje } from '../lib/opslag.js';
  import { band, BANDEN, VRAGEN } from '../data/huischeck.js';
  import { kamer } from '../data/kamers.js';
  import { LIJSTEN } from '../data/lijsten.js';

  /** Volgorde waarin je deuren dichtdoet: eerst de voordeur, dan de kluis, dan de rest. */
  const BOUWVOLGORDE = ['voordeur', 'tweede-slot', 'sleutelkluis', 'onderhoud', 'tweede-voordeur', 'brievenbus', 'sleutels', 'tuinhek', 'brandkast', 'eigendomsakte'];
  const BOUWLIJSTEN = ['niveau-1', 'niveau-2'];

  const sectie = document.querySelector<HTMLElement>('[data-huischeck]');
  if (sectie) {
    const kindSchakel = sectie.querySelector<HTMLInputElement>('[data-kind]')!;
    const vragen = Array.from(sectie.querySelectorAll<HTMLElement>('[data-vraag]'));
    const radios = Array.from(sectie.querySelectorAll<HTMLInputElement>('input[type=radio]'));

    function actieveVragen() {
      return vragen.filter((v) => !kindSchakel.checked || v.dataset.kindVraag === '1');
    }

    function vulIn(data = lees()) {
      radios.forEach((r) => {
        const nr = r.name.slice(1);
        const a = data.huischeck[nr];
        r.checked = (a === true && r.value === 'ja') || (a === false && r.value === 'nee') || (a === null && r.value === 'weet-niet');
      });
    }

    function toon() {
      const actief = actieveVragen();
      vragen.forEach((v) => { v.hidden = !actief.includes(v); });
      const totaal = actief.length;
      const antwoorden = actief.map((v) => sectie!.querySelector<HTMLInputElement>(`input[name=v${v.dataset.vraag}]:checked`)?.value);
      const beantwoord = antwoorden.filter(Boolean).length;
      const ja = antwoorden.filter((a) => a === 'ja').length;
      const schaal = totaal === 10 ? ja : Math.round((ja / totaal) * 10);

      sectie!.querySelector('[data-score]')!.textContent = String(ja);
      sectie!.querySelector('[data-score-tekst]')!.textContent = `keer ja van de ${totaal}`;
      const vul = sectie!.querySelector<HTMLElement>('[data-meter-vul]')!;
      vul.style.width = `${(ja / totaal) * 100}%`;
      vul.dataset.toestand = ja / totaal >= 0.8 ? 'dicht' : 'open';

      const klaar = beantwoord === totaal;
      const b = band(schaal);
      // zeg er ook bij dat de kindmodus vragen weglaat; anders verdwijnen er
      // zes vragen uit de pagina zonder dat iemand hoort waarom
      const kind = kindSchakel.checked ? `Vier vragen, samen met een kind. ` : '';
      sectie!.querySelectorAll<HTMLElement>('[data-band]').forEach((el) => { el.hidden = !klaar || BANDEN[Number(el.dataset.band)] !== b; });
      sectie!.querySelector<HTMLElement>('[data-open-deuren]')!.hidden = !klaar || ja === totaal;
      const lijst = sectie!.querySelector<HTMLElement>('[data-open-lijst]')!;
      const bewaard = lees().lijsten;
      const open = BOUWVOLGORDE
        .map((id) => actief.find((v, i) => VRAGEN.find((x) => x.nr === Number(v.dataset.vraag))!.kamer === id && antwoorden[i] !== 'ja'))
        .filter((v): v is HTMLElement => Boolean(v));
      let minuten = 0;
      lijst.replaceChildren(...open.map((v) => {
        const vraag = VRAGEN.find((x) => x.nr === Number(v.dataset.vraag))!;
        const k = kamer(vraag.kamer)!;
        const stappen = BOUWLIJSTEN.flatMap((l) => LIJSTEN[l].items.filter((it) => it.kamer === vraag.kamer).map((it) => ({ l, it })));
        const li = document.createElement('li');
        const kop = document.createElement('p');
        const a = document.createElement('a');
        a.href = stappen[0] ? `/aan-de-slag#${stappen[0].l}` : `/plattegrond#${k.anker}`;
        a.textContent = k.naam;
        kop.className = 'bouw-kamer';
        kop.append(a, document.createTextNode(` — ${k.wat}`));
        li.append(kop);
        if (!stappen.length) li.append(Object.assign(document.createElement('p'), { className: 'bouw-zin', textContent: k.zin }));
        stappen.forEach(({ l, it }) => {
          const gedaan = Boolean(bewaard[l]?.[it.id]);
          if (!gedaan) minuten += it.tijd ?? 0;
          const label = document.createElement('label');
          label.className = 'bouwstap';
          const vak = document.createElement('input');
          vak.type = 'checkbox';
          vak.checked = gedaan;
          vak.dataset.bouw = `${l}:${it.id}`;
          const tekst = document.createElement('span');
          tekst.textContent = it.stap;
          label.append(vak, tekst);
          if (it.tijd) label.append(Object.assign(document.createElement('span'), { className: 'bouw-min', textContent: `${it.tijd} min` }));
          li.append(label);
        });
        return li;
      }));
      sectie!.querySelector<HTMLElement>('[data-bouw-tijd]')!.textContent = minuten > 0 ? `Nog ongeveer ${minuten} minuten werk.` : '';
      const rest = sectie!.querySelector<HTMLElement>('[data-rest]')!;
      rest.hidden = klaar;
      const teGaan = totaal - beantwoord;
      rest.textContent = `Nog ${teGaan} ${teGaan === 1 ? 'vraag' : 'vragen'} te gaan.`;

      // Eén zin voor de schermlezer. Het hele uitslagblok voorlezen bij elke
      // klik is te veel; dit is wat je op dat moment wilt weten.
      const melding = sectie!.querySelector<HTMLElement>('[data-melding]')!;
      melding.textContent = kind + (klaar
        ? `Uitslag: ${ja} keer ja van de ${totaal}. ${b.kop}.`
        : `${ja} keer ja. Nog ${teGaan} ${teGaan === 1 ? 'vraag' : 'vragen'} te gaan.`);
    }

    // afvinken in de bouwvolgorde is hetzelfde vinkje als in hoofdstuk 4
    sectie.querySelector('[data-open-lijst]')!.addEventListener('change', (e) => {
      const vak = e.target as HTMLInputElement;
      if (!vak.dataset.bouw) return;
      const [l, id] = vak.dataset.bouw.split(':');
      zetVinkje(l, id, vak.checked);
    });

    vulIn();
    toon();
    radios.forEach((r) => r.addEventListener('change', () => {
      const waarde = r.value === 'ja' ? true : r.value === 'nee' ? false : null;
      zetAntwoord(r.name.slice(1), waarde);
      toon();
    }));
    kindSchakel.addEventListener('change', toon);
    window.addEventListener('jdh:gewijzigd', (e: Event) => { vulIn((e as CustomEvent).detail); toon(); });
  }
</script>

<style>
  .huischeck { margin: 1.5rem 0 2rem; }
  .schakel { margin-bottom: 1.25rem; font-size: 0.95rem; color: var(--inkt-zacht); }
  .schakel input { width: 1.2rem; height: 1.2rem; accent-color: var(--rood); margin-right: 0.4rem; }
  .vragen { list-style: none; padding: 0; margin: 0; border-top: var(--lijndikte) solid var(--lijn-sterk); }
  .vragen li { margin: 0; padding: 1rem 0; border-bottom: var(--lijndikte-dun) solid var(--lijn); }
  .vraag { margin: 0 0 0.6rem; font-weight: 700; }
  .nr { display: inline-block; min-width: 1.6rem; font-family: var(--kop); color: var(--rood); }
  .antwoorden { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .antwoord { display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0.3rem 1rem; border: var(--lijndikte) solid var(--lijn-sterk); border-radius: var(--radius); font-family: var(--kop); font-weight: 700; cursor: pointer; background: var(--papier); }
  .antwoord input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .antwoord:has(input:focus-visible) { outline: 3px solid var(--focus); outline-offset: 3px; }
  .ja:has(input:checked) { background: var(--groen); border-color: var(--groen); color: var(--op-kleur); }
  .nee:has(input:checked) { background: var(--rood); border-color: var(--rood); color: var(--op-kleur); }
  .weet:has(input:checked) { background: var(--inkt); border-color: var(--inkt); color: var(--papier); }
  .uitslag { margin-top: 2rem; padding: 1.25rem 1.4rem; border: var(--lijndikte) solid var(--lijn-sterk); border-radius: var(--radius); background: var(--papier-2); }
  .meter { height: 1rem; border: 2px solid var(--lijn-sterk); border-radius: 999px; overflow: hidden; margin: 0 0 0.6rem; background: var(--papier); }
  .meter span { display: block; height: 100%; width: 0; background: var(--rood); transition: width 0.3s ease; }
  .meter span[data-toestand="dicht"] { background: var(--groen); }
  .score { font-family: var(--kop); font-size: 1.5rem; margin: 0 0 0.75rem; }
  .score strong { font-size: 2.4rem; color: var(--rood); }
  .band h3 { margin: 0.5rem 0 0.3rem; }
  .band p:last-child { margin: 0 0 0.5rem; }
  .rest { margin: 0; color: var(--inkt-zacht); }
  .open-deuren { margin: 1rem 0 0; }
  .open-deuren h3 { margin: 0.5rem 0 0.3rem; }
  .open-deuren ol { margin: 0.4rem 0 0.75rem; padding-left: 1.4rem; }
  .open-deuren li { margin-bottom: 0.9rem; }
  .open-deuren :global(.bouw-kamer) { margin: 0 0 0.2rem; font-weight: 700; }
  .open-deuren :global(.bouw-zin) { margin: 0; color: var(--inkt-zacht); font-size: 0.95em; }
  .bouw-tijd { font-family: var(--kop); color: var(--inkt-zacht); margin: 0; }
  .open-deuren :global(.bouwstap) { display: flex; align-items: baseline; gap: 0.6rem; padding: 0.25rem 0; font-size: 0.97em; cursor: pointer; }
  .open-deuren :global(.bouwstap input) { width: 1.3rem; height: 1.3rem; accent-color: var(--groen); flex: none; position: static; opacity: 1; margin: 0; align-self: center; }
  .open-deuren :global(.bouwstap:has(input:checked) span:first-of-type) { text-decoration: line-through; color: var(--inkt-zacht); }
  .open-deuren :global(.bouw-min) { font-family: var(--kop); font-size: 0.8rem; color: var(--rood); letter-spacing: 0.05em; margin-left: auto; white-space: nowrap; }
</style>
