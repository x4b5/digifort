---
/** Het contactadres van de site: een SimpleLogin-alias, precies zoals hoofdstuk 4 aanraadt.
    Zonder adres valt de tekst terug op een nette melding in plaats van een kapotte mailto. */
import { SITE } from '../lib/site.js';
const adres = SITE.contact;
---
{adres
  ? <a href={`mailto:${adres}`}>{adres}</a>
  : <span class="placeholder">(e-mailadres volgt)</span>}
<style>
  .placeholder { color: var(--inkt-zacht); }
</style>
