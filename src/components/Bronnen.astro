---
/**
 * De bronnenlijst: elke bewering met de bron ernaast, gegroepeerd per hoofdstuk.
 * Zoeken, filteren op hoofdstuk en "alleen nog te koppelen" gaan in de browser.
 * Alles komt uit src/data/bronnen.js; hier staat geen tekst die daar ook staat.
 */
import { BRONNEN } from '../data/bronnen.js';
import { HOOFDSTUKKEN } from '../lib/site.js';

const titel = (slug: string) => HOOFDSTUKKEN.find((h) => h.slug === slug);

/** Elke bewering staat één keer, bij het eerste hoofdstuk waar hij hoort. */
const groepen = HOOFDSTUKKEN
  .map((h) => ({ ...h, items: BRONNEN.filter((b) => b.hoofdstuk[0] === h.slug) }))
  .filter((g) => g.items.length > 0);

const STATUSNAAM = { gecontroleerd: 'Gecontroleerd', 'nog-koppelen': 'Nog koppelen' };

type Stukje = { tekst: string, href?: string };

/**
 * Een bewering in bronnen.js rijgt soms vier feiten aan elkaar met puntkomma's.
 * Als losse punten scan je ze sneller, en lees je ze makkelijker: elk punt is één feit.
 * Een puntkomma binnen aanhalingstekens (een citaat) blijft staan.
 */
function delen(tekst: string): string[] {
  const uit: string[] = [];
  let begin = 0;
  let open = false;
  for (let i = 0; i < tekst.length; i += 1) {
    if (tekst[i] === '"') open = !open;
    if (!open && tekst[i] === ';' && /\s/.test(tekst[i + 1] ?? '')) {
      uit.push(tekst.slice(begin, i));
      begin = i + 1;
    }
  }
  uit.push(tekst.slice(begin));
  return uit.map((d) => hoofdletter(d.trim())).filter(Boolean);
}

/** Elk punt begint met een hoofdletter; iCloud en eSIM blijven zoals ze zijn. */
function hoofdletter(d: string) {
  return /^\p{Ll}\p{Lu}/u.test(d) ? d : d.charAt(0).toUpperCase() + d.slice(1);
}

/** Een toelichting op dezelfde manier in regels, met de links heel. */
function regels(stukjes: Stukje[]): Stukje[][] {
  const uit: Stukje[][] = [[]];
  for (const s of stukjes) {
    if (s.href) { uit.at(-1)!.push(s); continue; }
    const d = s.tekst.split(/;\s+/);
    d.forEach((tekst, i) => {
      if (i > 0) uit.push([]);
      if (tekst) uit.at(-1)!.push({ tekst: i > 0 ? hoofdletter(tekst) : tekst });
    });
  }
  return uit.filter((r) => r.length > 0);
}
---
<div class="bronnen" data-bronnen>
  <div class="filters">
    <label class="zoek">
      <span>Zoek in de bronnen</span>
      <input type="search" data-zoek placeholder="bijv. CBS, passkey, Kifid" autocomplete="off" />
    </label>
    <label class="kies">
      <span>Hoofdstuk</span>
      <select data-hoofdstuk>
        <option value="">Alle hoofdstukken</option>
        {groepen.map((g) => <option value={g.slug}>{g.nr === null ? '' : `${g.nr}. `}{g.titel}</option>)}
      </select>
    </label>
    <label class="open">
      <input type="checkbox" data-open />
      <span>Alleen wat nog te koppelen is</span>
    </label>
  </div>
  <p class="stand" data-stand aria-live="polite"></p>

  {groepen.map((g) => (
    <section class="groep" data-groep={g.slug}>
      {/* de kop noemt het hoofdstuk, met "Bronnen bij" ervoor: wie scant, ziet dat hier de bronnen staan en niet het antwoord */}
      <h3 id={g.slug}>Bronnen bij {g.titel}</h3>
      <p class="nr"><a href={`/${g.slug}`}>Naar het hoofdstuk zelf</a></p>
      <ul>
        {g.items.map((b) => (
          <li data-item data-status={b.status}>
            {delen(b.bewering).length > 1 ? (
              <ul class="bewering">{delen(b.bewering).map((d) => <li>{d}</li>)}</ul>
            ) : (
              <p class="bewering">{b.bewering}</p>
            )}
            {b.hoofdstuk.length > 1 && (
              <p class="ook">Ook bij {b.hoofdstuk.slice(1).map((s, i) => (
                <>{i > 0 && ', '}<a href={`/${s}`}>{titel(s)?.titel}</a></>
              ))}</p>
            )}
            <p class="bron">
              {b.bron.map((s, i) => (
                <>{i > 0 && '; '}{s.href ? <a href={s.href} rel="noopener">{s.tekst}</a> : s.tekst}</>
              ))}
            </p>
            <p class="status"><span class={`vlag ${b.status}`}>{STATUSNAAM[b.status]}</span></p>
            {b.toelichting && regels(b.toelichting).map((r) => (
              <p class="toelichting">{r.map((s) => (s.href ? <a href={s.href} rel="noopener">{s.tekst}</a> : s.tekst))}</p>
            ))}
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-bronnen]').forEach((blok) => {
    const veld = blok.querySelector<HTMLInputElement>('[data-zoek]')!;
    const keuze = blok.querySelector<HTMLSelectElement>('[data-hoofdstuk]')!;
    const alleenOpen = blok.querySelector<HTMLInputElement>('[data-open]')!;
    const stand = blok.querySelector<HTMLElement>('[data-stand]')!;
    const groepen = Array.from(blok.querySelectorAll<HTMLElement>('[data-groep]'));
    const items = Array.from(blok.querySelectorAll<HTMLLIElement>('[data-item]'));
    const totaal = items.length;

    function filter() {
      const q = veld.value.trim().toLowerCase();
      const slug = keuze.value;
      const open = alleenOpen.checked;
      let n = 0;
      groepen.forEach((g) => {
        let zichtbaar = 0;
        g.querySelectorAll<HTMLLIElement>('[data-item]').forEach((li) => {
          const past =
            (!q || li.textContent!.toLowerCase().includes(q)) &&
            (!slug || g.dataset.groep === slug) &&
            (!open || li.dataset.status === 'nog-koppelen');
          li.hidden = !past;
          if (past) zichtbaar += 1;
        });
        g.hidden = zichtbaar === 0;
        n += zichtbaar;
      });
      const alles = !q && !slug && !open;
      stand.textContent = alles ? `${totaal} feiten met een bron`
        : n === 0 ? 'Niets gevonden. Probeer een ander woord of een ander hoofdstuk.'
        : `${n} van ${totaal} feiten`;
    }

    veld.addEventListener('input', filter);
    keuze.addEventListener('change', filter);
    alleenOpen.addEventListener('change', filter);
    filter();
  });
</script>

<style>
  .filters { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 1rem; margin: 1.25rem 0 0.75rem; }
  .zoek, .kies { display: flex; flex-direction: column; gap: 0.35rem; font-weight: 700; }
  .zoek input, .kies select { font: inherit; font-size: 1.05rem; padding: 0.55rem 0.8rem; border: var(--lijndikte) solid var(--lijn-sterk); border-radius: var(--radius); background: var(--papier); color: var(--inkt); }
  .zoek input { min-width: min(22rem, 100%); }
  /* een keuzelijst is zo breed als zijn langste hoofdstuktitel; op een telefoon mag hij niet buiten beeld */
  .kies { max-width: 100%; }
  .kies select { max-width: 100%; }
  .open { display: flex; align-items: center; gap: 0.45rem; padding-bottom: 0.6rem; }
  .open input { width: 1.1rem; height: 1.1rem; accent-color: var(--rood); }
  /* aanraakscherm: minstens 44px om met een duim te raken (WCAG 2.5.5) */
  @media (pointer: coarse) { .open { min-block-size: 44px; padding-bottom: 0; } .open input { width: 1.4rem; height: 1.4rem; } }
  .stand { margin: 0 0 1.5rem; color: var(--inkt-zacht); }

  .groep { margin: 2.25rem 0; }
  .groep h3 { margin: 0 0 0.25rem; }
  .groep .nr { margin: 0 0 0.75rem; font-size: var(--tekst-m); color: var(--inkt-zacht); }
  .groep > ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.75rem; }
  [data-item] { margin: 0; padding: 0.9rem 1.1rem; border: var(--lijndikte-dun) solid var(--lijn); border-radius: var(--radius); background: var(--papier); }
  [data-item] > p, [data-item] > ul { margin: 0 0 0.35rem; }
  [data-item] > :last-child { margin-bottom: 0; }
  .bewering { font-weight: 700; }
  /* een bewering met meer feiten: elk feit een eigen punt */
  ul.bewering { padding-left: 1.2rem; display: grid; gap: 0.25rem; }
  ul.bewering li { margin: 0; }
  .toelichting { font-size: var(--tekst-m); color: var(--inkt-zacht); }
  .ook, .bron { font-size: var(--tekst-m); }
  .ook { color: var(--inkt-zacht); }
  .status { font-size: var(--tekst-m); }
  .vlag { font-family: var(--mono); font-size: var(--tekst-s); letter-spacing: 0.06em; text-transform: uppercase; padding: 0.15rem 0.5rem; border-radius: var(--radius); white-space: nowrap; }
  /* kleur zit in het vlak en het streepje, niet in de letter: groen op groen haalt 4,5:1 niet */
  .vlag.gecontroleerd { background: var(--groen-licht); color: var(--inkt); border-left: 4px solid var(--groen); }
  .vlag.nog-koppelen { background: var(--papier-2); color: var(--inkt); border-left: 4px solid var(--inkt-flauw); }
</style>
