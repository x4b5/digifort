---
/** Een echte foto bij de tekst: het kader van een tekening, met maker en licentie erbij. */
import { Image } from 'astro:assets';
import { FOTOS } from '../data/fotos.js';

// sizes en laden zijn er voor een grote foto bovenaan een pagina; de standaard past bij een foto in de tekst
const { id, onderschrift, breed = false, sizes = '(max-width: 45rem) 100vw, 40rem', laden = 'lazy', klasse = '' } = Astro.props;
const foto = FOTOS[id];
if (!foto) throw new Error(`Onbekende foto: ${id}`);

const bestanden = import.meta.glob<{ default: ImageMetadata }>('../assets/foto/*.{jpg,jpeg,png,webp}', { eager: true });
const bron = bestanden[`../assets/foto/${foto.bestand}`];
if (!bron) throw new Error(`Foto ontbreekt in src/assets/foto: ${foto.bestand}`);
---
<figure class:list={['tekening', 'foto', { breed }, klasse]}>
  <Image src={bron.default} alt={foto.alt} widths={[480, 720, 960, 1440].filter((w) => w <= bron.default.width)} sizes={sizes} loading={laden} fetchpriority={laden === 'eager' ? 'high' : undefined} decoding="async" />
  <figcaption>
    {onderschrift && <span>{onderschrift} </span>}
    <span class="herkomst">
      Foto: <a href={foto.bron} rel="nofollow noopener">{foto.maker}</a>,{' '}
      {foto.licentieBron ? <a href={foto.licentieBron} rel="nofollow noopener">{foto.licentie}</a> : foto.licentie}.
    </span>
  </figcaption>
</figure>
<style>
  .breed { max-width: none; }
</style>
