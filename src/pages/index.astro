---
import { websiteGegevens } from '../lib/gegevens.js';
import Pagina from '../layouts/Pagina.astro';
import HoofdstukIcoon from '../components/HoofdstukIcoon.astro';
import HuisEnFort from '../components/HuisEnFort.astro';
import Verder from '../components/Verder.astro';
import Snelcheck from '../components/Snelcheck.astro';
import Poppetjes from '../components/Poppetjes.astro';
import { metVerdiepingen } from '../lib/site.js';
/** De twee plekken waar je begint: groter en groen, zodat het raster een begin heeft. */
const START: Record<string, string> = { huischeck: 'Begin hier', 'aan-de-slag': 'Dan dit' };
---
<Pagina breed gegevens={websiteGegevens()} beschrijving="Elke app is een deur naar je huis. Deze site laat zien waar je digitale huis openstaat en hoe je het stap voor stap dichtmaakt. Gratis, in gewone taal.">
  <section class="hero">
    <div class="hero-tekst">
      <p class="eyebrow">Digitale weerbaarheid in gewone taal</p>
      <h1>Van open huis naar fort.</h1>
      <p class="intro">Je gaat niet naar het internet. Het internet komt bij jou binnen. Elke app, elk account en elk apparaat is een deur, en bij de meeste mensen <a href="/huischeck#hoe-weten-we-dat">staan die deuren open</a>. Deze site helpt je ze dicht te doen, stap voor stap, tot je huis een fort is. Zonder bangmakerij en zonder reclame.</p>
      <p class="knoppen">
        <a class="knop" href="/huischeck#doe-de-huischeck">Doe de huischeck →</a>
        <a class="knop licht" href="/een-avond">Ik heb één avond</a>
        <a class="knop licht" href="/de-storm-om-het-huis">Waarom nu?</a>
      </p>
      <Verder />
    </div>
    <aside class="hero-cijfer" aria-label="Eén cijfer">
      <Poppetjes rood={1} van={10} />
      <strong class="getal">1 op 10</strong>
      <p>Nederlanders van 15 jaar en ouder werd in 2025 online opgelicht. Gehackt worden gebeurde minder vaak: 6 op 100. De meeste inbrekers breken niets open. Ze bellen aan.</p>
      <a class="bron" href="https://www.cbs.nl/nl-nl/longread/rapportages/2026/veiligheidsmonitor-2025/6-online-criminaliteit">CBS, Veiligheidsmonitor 2025</a>
    </aside>
  </section>

  <section class="fort" id="fort">
    <h2 class="fort-kop">Hoe staat jouw fort ervoor?</h2>
    <p class="tekst">Drie vragen, tien seconden. Wat je regelt, kleurt <span class="kleur groen">groen</span>; wat openstaat, kleurt <span class="kleur rood">rood</span>. Kijk wat er met het fort hieronder gebeurt.</p>
    <Snelcheck />
    <p class="tekst fort-uitleg">Links het huis waar de meeste mensen in wonen. Rechts het fort waar we naartoe werken. Elk deel hoort bij een stap uit <a href="/aan-de-slag">hoofdstuk 4</a>.</p>
    <HuisEnFort />
  </section>

  <section class="hoofdstukken">
    <h2>De hoofdstukken</h2>
    <ol class="kaarten">
      {metVerdiepingen().map((h) => (
        <li class:list={{ start: START[h.slug], 'met-lade': h.verdiepingen.length > 0 }}>
          <a class="kaart" href={`/${h.slug}`}>
            <span class="kaart-kop"><span class="nr">Hoofdstuk {h.nr}</span><HoofdstukIcoon slug={h.slug} maat={START[h.slug] ? 56 : 40} /></span>
            <h3>{h.titel}</h3>
            <p>{h.kort}</p>
            {START[h.slug] && <span class="start-label">{START[h.slug]} →</span>}
          </a>
          {h.verdiepingen.length > 0 && (
            <details class="lade">
              <summary>{h.verdiepingen.length === 1 ? '1 verdieping' : `${h.verdiepingen.length} verdiepingen`}</summary>
              <ul>
                {h.verdiepingen.map((v) => (
                  <li><a href={`/${v.slug}`}><strong>{v.titel}</strong><span>{v.kort}</span></a></li>
                ))}
              </ul>
            </details>
          )}
        </li>
      ))}
    </ol>
  </section>
</Pagina>

<style>
  /* de tekstkolom blijft leesbaar smal, maar de knoppen mogen de volle breedte
     gebruiken: anders valt de derde op een breed scherm alleen op een tweede regel */
  .hero { padding-bottom: 1rem; display: grid; gap: 1.5rem 2.5rem; align-items: end; }
  @media (min-width: 60rem) { .hero { grid-template-columns: minmax(0, 1fr) 17rem; } }
  .hero-cijfer { border-left: 6px solid var(--rood); padding: 0.25rem 0 0.25rem 1.1rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .hero-cijfer .getal { font-family: var(--kop); font-size: clamp(2.6rem, 6vw, 3.4rem); line-height: 1; color: var(--rood); letter-spacing: -0.02em; }
  .hero-cijfer p { margin: 0; font-size: 1rem; line-height: 1.45; }
  .hero-cijfer .bron { align-self: flex-start; padding: 0.3rem 0; font-family: var(--kop); font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--inkt-zacht); text-decoration-thickness: 1px; }
  .fort-uitleg { margin-top: 2rem; }
  .hero-tekst > :not(.knoppen) { max-width: var(--maat); }
  .hero h1 { font-size: clamp(2.2rem, 6vw, 3.6rem); }
  .knoppen { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .fort-kop { margin-top: 2rem; }
  .kleur { font-weight: 700; padding: 0 0.3rem; border-radius: var(--radius); color: var(--op-kleur); }
  .kleur.rood { background: var(--rood); }
  .kleur.groen { background: var(--groen); }
  .hoofdstukken h2 { margin-top: 3rem; }
  .kaart-kop { display: flex; justify-content: space-between; align-items: center; }
  /* een hoofdstuk met verdiepingen krijgt een lade onder de kaart: dicht is het
     één regel, open staan de verdiepingen eronder. Zo blijft het raster rustig. */
  .kaarten > li { display: flex; flex-direction: column; }
  .kaarten > li > .kaart { flex: 1; }
  li.met-lade > .kaart { border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
  .lade { border: var(--lijndikte) solid var(--lijn-sterk); border-top: 0; border-radius: 0 0 var(--radius) var(--radius); background: var(--papier-2); }
  .lade summary { padding: 0.6rem 1.2rem; min-block-size: 44px; display: flex; align-items: center; gap: 0.4rem; list-style: none; cursor: pointer; font-family: var(--kop); font-size: 0.9rem; color: var(--inkt-zacht); }
  .lade summary::-webkit-details-marker { display: none; }
  .lade summary::before { content: '▸'; transition: transform 0.15s ease; }
  .lade[open] summary::before { transform: rotate(90deg); }
  .lade summary:hover { color: var(--inkt); }
  .lade ul { list-style: none; margin: 0; padding: 0 0 0.5rem; }
  .lade li { margin: 0; }
  .lade li a { display: flex; flex-direction: column; gap: 0.15rem; padding: 0.5rem 1.2rem 0.5rem 2.2rem; color: var(--inkt); text-decoration: none; }
  .lade li a:hover { background: var(--papier); }
  .lade li span { color: var(--inkt-zacht); font-size: 0.9rem; line-height: 1.4; }
  @media (prefers-reduced-motion: reduce) { .lade summary::before { transition: none; } }
  li.start .kaart { background: var(--groen-licht); display: flex; flex-direction: column; }
  li.start .kaart:hover { background: var(--papier-2); }
  li.start .nr { color: var(--inkt); }
  li.start h3 { font-size: 1.6rem; }
  li.start p { font-size: 1.05rem; color: var(--inkt); }
  .start-label { margin-top: auto; padding-top: 0.9rem; font-family: var(--kop); font-weight: 700; color: var(--groen); }
  @media (min-width: 40rem) { li.start { grid-column: span 2; } }
  /* op een telefoon moeten de knoppen in het eerste scherm passen */
  @media (max-width: 40rem) { .hero .intro { font-size: 1.12rem; } }
</style>
