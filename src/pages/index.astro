---
import Pagina from '../layouts/Pagina.astro';
import HoofdstukIcoon from '../components/HoofdstukIcoon.astro';
import HuisEnFort from '../components/HuisEnFort.astro';
import { HOOFDSTUKKEN } from '../lib/site.js';
---
<Pagina breed beschrijving="Je gaat niet naar het internet, het internet komt bij jou binnen. Elke app is een deur. Deze site loopt met je mee tot je huis een fort is. Gratis, in gewone taal, zonder reclame.">
  <section class="hero">
    <div class="hero-tekst">
      <p class="eyebrow">Digitale veiligheid in gewone taal</p>
      <h1>Van open huis naar fort.</h1>
      <p class="intro">Je gaat niet naar het internet. Het internet komt bij jou binnen. Elke app, elk account en elk apparaat is een deur, en bij de meeste mensen <a href="/huischeck#hoe-weten-we-dat">staan die deuren open</a>. Deze site loopt met je mee tot je huis een fort is: een muur, een gracht, een poort met twee sloten. Zonder bangmakerij en zonder reclame.</p>
      <p class="knoppen">
        <a class="knop" href="/huischeck#doe-de-huischeck">Doe de huischeck →</a>
        <a class="knop licht" href="/een-avond">Ik heb één avond</a>
        <a class="knop licht" href="/de-storm-om-het-huis">Waarom nu?</a>
      </p>
    </div>
  </section>

  <section class="fort" id="fort">
    <h2 class="fort-kop">Waar we naartoe werken</h2>
    <p class="tekst">Links het huis waar de meeste mensen in wonen. Rechts het fort. Elk deel van het fort hoort bij een stap uit <a href="/aan-de-slag">hoofdstuk 4</a>. Wat je regelt, kleurt <span class="kleur groen">groen</span>; wat openstaat, kleurt <span class="kleur rood">rood</span>.</p>
    <HuisEnFort />
  </section>

  <section class="hoofdstukken">
    <h2>De hoofdstukken</h2>
    <ol class="kaarten">
      {HOOFDSTUKKEN.map((h) => (
        <li class:list={{ extra: h.extra }}>
          <a class="kaart" href={`/${h.slug}`}>
            <span class="kaart-kop"><span class="nr">{h.extra ? 'Verdieping' : `Hoofdstuk ${h.nr}`}</span><HoofdstukIcoon slug={h.slug} maat={40} /></span>
            <h3>{h.titel}</h3>
            <p>{h.kort}</p>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Pagina>

<style>
  /* de tekstkolom blijft leesbaar smal, maar de knoppen mogen de volle breedte
     gebruiken: anders valt de derde op een breed scherm alleen op een tweede regel */
  .hero { padding-bottom: 1rem; }
  .hero-tekst > :not(.knoppen) { max-width: var(--maat); }
  .hero h1 { font-size: clamp(2.2rem, 6vw, 3.6rem); }
  .knoppen { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .fort-kop { margin-top: 2rem; }
  .kleur { font-weight: 700; padding: 0 0.3rem; border-radius: var(--radius); color: var(--op-kleur); }
  .kleur.rood { background: var(--rood); }
  .kleur.groen { background: var(--groen); }
  .hoofdstukken h2 { margin-top: 3rem; }
  .kaart-kop { display: flex; justify-content: space-between; align-items: center; }
  li.extra .kaart { border-style: dashed; border-width: 2px; padding: calc(1.1rem + 1px) calc(1.2rem + 1px); background: var(--papier-2); }
  li.extra .nr { color: var(--inkt-zacht); }
</style>
