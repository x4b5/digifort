---
import { getCollection, render } from 'astro:content';
import Pagina from '../layouts/Pagina.astro';
import { tredeKoppen } from '../data/tredes.js';
import HoofdstukIcoon from '../components/HoofdstukIcoon.astro';
import Buren from '../components/Buren.astro';
import Quiz from '../components/Quiz.astro';
import { quiz } from '../data/quiz.js';

export async function getStaticPaths() {
  const hoofdstukken = await getCollection('hoofdstukken');
  return hoofdstukken.map((h) => ({ params: { slug: h.id }, props: { h } }));
}

const { h } = Astro.props;
const { Content, headings } = await render(h);
// ruwe leestijd: ongeveer 200 woorden per minuut, afgerond op hele minuten.
// Alleen de lopende tekst telt: import-regels, componenten met hun gegevens en
// de adressen achter links leest niemand. Naslagpagina's lees je niet van a tot z.
const NASLAG = ['woordenboek', 'bronnen'];
const leestekst = (h.body ?? '')
  .replace(/^(import|export) .*$/gm, '')
  .replace(/<[^>]*>/g, ' ')
  .replace(/\{[^}]*\}/g, ' ')
  .replace(/\]\([^)]*\)/g, ']');
const woorden = leestekst.split(/\s+/).filter((w) => /\p{L}/u.test(w)).length;
const minuten = Math.max(1, Math.round(woorden / 200));
const leestijd = NASLAG.includes(h.id) ? null : `${minuten} ${minuten === 1 ? 'minuut' : 'minuten'}`;
// de acht treden zijn koppen uit een component, dus die ziet render() niet;
// zonder deze regel mist juist het skelet waar de ladderpagina om draait
const koppen = [
  ...(h.id === 'van-geheim-woord-naar-zegelring' ? tredeKoppen() : []),
  ...headings.filter((k) => k.depth === 2),
  // de quiz is een component, dus render() ziet die kop niet; zonder deze regel
  // staat er onderaan iets waar de inhoudsopgave niets over zegt
  ...(quiz(h.id).length ? [{ slug: 'quiz', text: 'Wat blijft er hangen?', depth: 2 }] : []),
];
---
<Pagina titel={h.data.titel} beschrijving={h.data.kort} datum={h.data.datum}>
  {leestijd && <div class="leesbalk" aria-hidden="true" />}
  <div class="paginakop">
    <div>
      <p class="eyebrow">{h.data.nr === null ? 'Verdieping' : `Hoofdstuk ${h.data.nr}`}</p>
      <h1>{h.data.titel}</h1>
      {leestijd && (
        <p class="leestijd">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 7 V12 L15.5 14" /></svg>
          Ongeveer {leestijd} lezen
        </p>
      )}
    </div>
    <HoofdstukIcoon slug={h.id} maat={72} />
  </div>
  {koppen.length >= 3 && (
    <nav aria-label="In dit hoofdstuk">
      <details class="inhoud" open data-inhoud>
        <summary class="eyebrow zacht klein inhoud-kop">In dit hoofdstuk <span class="aantal">· {koppen.length} onderdelen</span></summary>
        <ol>{koppen.map((k) => <li><a href={`#${k.slug}`}>{k.text}</a></li>)}</ol>
      </details>
    </nav>
  )}
  <script>
    // op een smal scherm vult de opgave anders het hele eerste scherm, en staat de
    // openingsscène pas onder de vouw; zonder JavaScript blijft hij gewoon open
    if (window.matchMedia('(max-width: 40rem)').matches) {
      document.querySelector<HTMLDetailsElement>('[data-inhoud]')?.removeAttribute('open');
    }
  </script>
  <Content />
  <Quiz slug={h.id} />
  <Buren slug={h.id} />
</Pagina>

<style>
  /* Een dunne lijn bovenin die meegroeit terwijl je leest. De browser koppelt hem zelf
     aan het scrollen, zonder JavaScript; een browser die dat niet kan, toont hem niet.
     Inkt en geen rood: hoe ver je bent is geen gevaar en ook nog niets geregelds. */
  .leesbalk {
    position: fixed; inset: 0 0 auto; height: 3px; z-index: 6;
    background: var(--inkt); transform-origin: left center; transform: scaleX(0);
    pointer-events: none;
  }
  @supports (animation-timeline: scroll()) {
    .leesbalk { animation: lees linear both; animation-duration: auto !important; animation-timeline: scroll(root); }
  }
  /* 'from' uitgeschreven: zonder rekent WebKit de lijn kwadratisch (bij de helft pas een kwart) */
  @keyframes lees { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @media print { .leesbalk { display: none; } }
  .inhoud { margin: 1.5rem 0 0.5rem; padding: 1rem 1.2rem; border: var(--lijndikte-dun) solid var(--lijn); border-radius: var(--radius); font-size: 0.95rem; }
  .inhoud-kop { margin-bottom: 0.4rem; cursor: pointer; list-style: none; display: flex; align-items: center; gap: 0.4rem; }
  .inhoud-kop::-webkit-details-marker { display: none; }
  .inhoud-kop::after { content: "▸"; font-size: 1rem; transition: transform 0.15s ease; }
  .inhoud[open] .inhoud-kop::after { transform: rotate(90deg); }
  .inhoud:not([open]) .inhoud-kop { margin-bottom: 0; }
  .aantal { text-transform: none; letter-spacing: 0; }
  @media (min-width: 40.01rem) { .aantal { display: none; } }
  .inhoud ol { margin: 0; padding-left: 1.4rem; columns: 2; column-gap: 2rem; }
  .inhoud li { margin: 0.15rem 0; break-inside: avoid; }
  .inhoud a { color: var(--inkt); text-decoration: none; }
  .inhoud a:hover { color: var(--rood); text-decoration: underline; }
  /* aanraakscherm: minstens 44px om met een duim te raken (WCAG 2.5.5) */
  @media (pointer: coarse) { .inhoud-kop { min-block-size: 44px; } .inhoud li { margin: 0; } .inhoud a { display: flex; align-items: center; min-block-size: 44px; } }
  @media (max-width: 40rem) { .inhoud ol { columns: 1; } }
  .leestijd { display: flex; align-items: center; gap: 0.4rem; margin: -0.4rem 0 0; color: var(--inkt-zacht); font-size: 0.95rem; }
  .leestijd svg { flex: none; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .paginakop { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; }
  .paginakop > div { min-width: 0; }
  /* een hoofdstuktitel deelt zijn regel met het icoon; op de volle maat van global.css
     paste een lang woord als "Woordenboek" daar niet meer naast */
  .paginakop h1 { font-size: clamp(2.1rem, 6vw, 3.25rem); }
  .paginakop > :global(.hicoon) { flex: none; margin-top: 0.4rem; }
  @media (max-width: 40rem) { .paginakop > :global(.hicoon) svg { width: 48px; height: 48px; } }
</style>
