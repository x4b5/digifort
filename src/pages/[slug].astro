---
import { getCollection, render } from 'astro:content';
import Pagina from '../layouts/Pagina.astro';
import { buren } from '../lib/site.js';
import HoofdstukIcoon from '../components/HoofdstukIcoon.astro';

export async function getStaticPaths() {
  const hoofdstukken = await getCollection('hoofdstukken');
  return hoofdstukken.map((h) => ({ params: { slug: h.id }, props: { h } }));
}

const { h } = Astro.props;
const { Content, headings } = await render(h);
const koppen = headings.filter((k) => k.depth === 2);
const { vorige, volgende } = buren(h.id);
---
<Pagina titel={h.data.titel} beschrijving={h.data.kort} datum={h.data.datum}>
  <div class="paginakop">
    <div>
      <p class="eyebrow">{h.data.nr === null ? 'Verdieping' : `Hoofdstuk ${h.data.nr}`}</p>
      <h1>{h.data.titel}</h1>
    </div>
    <HoofdstukIcoon slug={h.id} maat={72} />
  </div>
  {koppen.length >= 3 && (
    <nav class="inhoud" aria-label="In dit hoofdstuk">
      <p class="inhoud-kop">In dit hoofdstuk</p>
      <ol>{koppen.map((k) => <li><a href={`#${k.slug}`}>{k.text}</a></li>)}</ol>
    </nav>
  )}
  <Content />
  <nav class="buren" aria-label="Vorige en volgende">
    {vorige && <a class="knop licht" href={`/${vorige.slug}`}>← {vorige.titel}</a>}
    {volgende && <a class="knop" href={`/${volgende.slug}`}>{volgende.titel} →</a>}
  </nav>
</Pagina>

<style>
  .inhoud { margin: 1.5rem 0 0.5rem; padding: 1rem 1.2rem; border: 2px solid var(--lijn); border-radius: var(--radius); font-size: 0.95rem; }
  .inhoud-kop { font-family: var(--kop); font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--inkt-zacht); margin: 0 0 0.4rem; }
  .inhoud ol { margin: 0; padding-left: 1.4rem; columns: 2; column-gap: 2rem; }
  .inhoud li { margin: 0.15rem 0; break-inside: avoid; }
  .inhoud a { color: var(--inkt); text-decoration: none; }
  .inhoud a:hover { color: var(--rood); text-decoration: underline; }
  @media (max-width: 40rem) { .inhoud ol { columns: 1; } }
  .paginakop { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; }
  .paginakop > :global(.hicoon) { flex: none; margin-top: 0.4rem; }
  @media (max-width: 40rem) { .paginakop > :global(.hicoon) svg { width: 48px; height: 48px; } }
  .buren { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: space-between; margin-top: 3.5rem; padding-top: 1.5rem; border-top: var(--lijndikte) solid var(--lijn-sterk); }
  .buren a { max-width: 100%; text-align: left; }
</style>
