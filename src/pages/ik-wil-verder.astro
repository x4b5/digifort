---
import Pagina from '../layouts/Pagina.astro';
import Avond from '../components/Avond.astro';
import { VERDER } from '../data/verder.js';
import HoofdstukIcoon from '../components/HoofdstukIcoon.astro';
import Buren from '../components/Buren.astro';
import Plek from '../components/Plek.astro';
import { artikelGegevens } from '../lib/gegevens.js';
import { SITE } from '../lib/site.js';

const BESCHRIJVING = 'Zes klussen, één per scherm, voor wie de basis heeft staan. Neem er de tijd voor.';
---
<Pagina titel="Ik wil verder" beschrijving={BESCHRIJVING} soort="article"
  gegevens={artikelGegevens({ slug: 'ik-wil-verder', titel: 'Ik wil verder', beschrijving: BESCHRIJVING, datum: SITE.laatstNagelopen })}>
  <div class="paginakop">
    <div>
      <Plek slug="ik-wil-verder" />
      <h1>Ik wil verder</h1>
    </div>
    <HoofdstukIcoon slug="ik-wil-verder" maat={72} />
  </div>
  <p class="intro">Zes klussen, één per scherm, voor wie niveau 1 en 2 al heeft staan. Doe ze in je eigen tempo, één per keer is ook goed. Wat je afvinkt, telt mee in <a href="/aan-de-slag#niveau-3">Aan de slag</a>.</p>
  <Avond lijst="niveau-3" uitleg={VERDER} moment="Klaar met niveau 3" alles="Alle zes de klussen van niveau 3 zijn gedaan. Je fort heeft de zwaarste sloten die er zijn." volgende={{ href: '/het-fort-afbouwen', tekst: 'Nog verder: het fort afbouwen →' }} />
  <Buren slug="ik-wil-verder" />
</Pagina>
<style>
  .paginakop { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; }
  .paginakop > :global(.hicoon) { flex: none; margin-top: 0.4rem; }
</style>
