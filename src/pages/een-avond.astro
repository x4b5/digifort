---
import Pagina from '../layouts/Pagina.astro';
import Avond from '../components/Avond.astro';
import HoofdstukIcoon from '../components/HoofdstukIcoon.astro';
import Buren from '../components/Buren.astro';
import Plek from '../components/Plek.astro';
import { artikelGegevens } from '../lib/gegevens.js';
import { SITE } from '../lib/site.js';

const BESCHRIJVING = 'Zes stappen, één per scherm, ongeveer een uur. Bij elke stap: hoe je het doet, hoe je ziet dat het gelukt is, en wat je doet als het niet lukt.';
---
<Pagina titel="Ik heb één avond" beschrijving={BESCHRIJVING} soort="article"
  gegevens={artikelGegevens({ slug: 'een-avond', titel: 'Ik heb één avond', beschrijving: BESCHRIJVING, datum: SITE.laatstNagelopen })}>
  <div class="paginakop">
    <div>
      <Plek slug="een-avond" />
      <h1>Ik heb één avond</h1>
    </div>
    <HoofdstukIcoon slug="een-avond" maat={72} />
  </div>
  <p class="intro">Zes stappen, één per scherm.</p>
  <Avond />
  <Buren slug="een-avond" />
</Pagina>
<style>
  .paginakop { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; }
  .paginakop > :global(.hicoon) { flex: none; margin-top: 0.4rem; }
</style>
