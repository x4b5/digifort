---
import '../styles/global.css';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import { SITE } from '../lib/site.js';

const { titel, beschrijving = SITE.slogan, datum = SITE.laatstNagelopen, breed = false } = Astro.props;
const paginaTitel = titel ? `${titel} · ${SITE.naam}` : `${SITE.naam} Van open huis naar fort`;
const hier = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={beschrijving} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141414" media="(prefers-color-scheme: dark)" />
    <title>{paginaTitel}</title>
    <link rel="canonical" href={hier} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.naam} />
    <meta property="og:title" content={paginaTitel} />
    <meta property="og:description" content={beschrijving} />
    <meta property="og:url" content={hier} />
    <meta property="og:image" content={new URL('/deelplaatje.png', Astro.site)} />
    <meta property="og:image:alt" content="Links een open huis met een scheur en een sleutel onder de mat, rechts hetzelfde huis als fort met een muur en een gracht." />
    <meta property="og:locale" content="nl_NL" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- leesvoorkeur meteen toepassen, anders flitst de pagina even in de andere stand.
         Dezelfde sleutel als in src/lib/lezen.js. -->
    <script is:inline>
      try {
        var v = JSON.parse(window.localStorage.getItem('jdh:lezen') || '{}');
        if (v.tekst && v.tekst !== 'normaal') document.documentElement.dataset.tekst = v.tekst;
        if (v.thema && v.thema !== 'auto') document.documentElement.dataset.theme = v.thema;
      } catch (e) { /* opslag geblokkeerd: gewoon de standaardstand */ }
    </script>
  </head>
  <body>
    <a class="overslaan" href="#inhoud">Naar de inhoud</a>
    <Kop />
    <main id="inhoud" class:list={['wrap', { tekst: !breed }]}>
      <slot />
    </main>
    <Voet datum={datum} />
    <script>
      import { wisAlles } from '../lib/opslag.js';

      // brede tabellen scrollen in hun eigen bak, niet de hele pagina;
      // op een telefoon stapelen ze per rij, met de kolomkop erbij (niet het woordenboek: dat filtert)
      document.querySelectorAll('main table').forEach((t) => {
        const koppen = Array.from(t.querySelectorAll('thead th')).map((th) => th.textContent?.trim() ?? '');
        if (koppen.length >= 3 && !t.closest('[data-woordenboek]')) {
          t.classList.add('tabel-stapel');
          t.querySelectorAll('tbody tr').forEach((rij) => {
            rij.querySelectorAll('td').forEach((cel, i) => { cel.dataset.label = koppen[i] ?? ''; });
          });
        }
        if (t.parentElement?.classList.contains('tabel-scroll')) return;
        const bak = document.createElement('div');
        bak.className = 'tabel-scroll';
        bak.tabIndex = 0;
        bak.setAttribute('role', 'region');
        bak.setAttribute('aria-label', 'Tabel, zijwaarts te scrollen');
        t.replaceWith(bak);
        bak.append(t);
      });

      // een link naar een andere site opent in een nieuw tabblad, zodat digiFORT open blijft;
      // eigen links blijven in hetzelfde venster, anders stapelen de tabbladen zich op
      document.querySelectorAll<HTMLAnchorElement>('a[href^="http"]').forEach((a) => {
        if (a.host === location.host) return;
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
      });

      // een tekening krimpt op een telefoon als geheel, en de tekst erin krimpt mee tot
      // een pixel of zes. --krimp zegt hoeveel kleiner de tekening getekend wordt dan hij
      // bedoeld is; global.css zet de tekst daarmee terug op een leesbare maat.
      const tekeningen = Array.from(document.querySelectorAll('main svg[viewBox]'))
        .filter((svg): svg is SVGSVGElement => svg instanceof SVGSVGElement && svg.querySelector('text') !== null);
      const meetKrimp = new ResizeObserver((regels) => {
        for (const { target } of regels) {
          const svg = target as SVGSVGElement;
          const breedte = svg.getBoundingClientRect().width;
          if (breedte) svg.style.setProperty('--krimp', String(svg.viewBox.baseVal.width / breedte));
        }
      });
      tekeningen.forEach((svg) => meetKrimp.observe(svg));

      // je voortgang staat alleen in deze browser; op papier gaat hij wel mee.
      // De printstijl laat de lijsten en het noodpakket staan en de rest weg.
      document.querySelectorAll('[data-print]').forEach((knop) => {
        knop.addEventListener('click', () => window.print());
      });

      // wissen kan niet ongedaan gemaakt worden, dus pas op de tweede klik.
      // De knop blijft bruikbaar; de bevestiging gaat naar een aparte melding,
      // want een knop die zichzelf uitschakelt verliest de focus en wordt niet voorgelezen.
      document.querySelectorAll<HTMLElement>('[data-wis]').forEach((knop) => {
        const melding = document.querySelector('[data-wis-melding]');
        const label = knop.textContent;
        let klok: ReturnType<typeof setTimeout>;

        function herstel() {
          clearTimeout(klok);
          knop.dataset.bevestig = '';
          knop.textContent = label;
        }

        knop.addEventListener('click', () => {
          if (!knop.dataset.bevestig) {
            knop.dataset.bevestig = 'ja';
            knop.textContent = 'Weet je het zeker?';
            klok = setTimeout(herstel, 8000);
            return;
          }
          wisAlles();
          herstel();
          if (melding) melding.textContent = 'Je antwoorden en vinkjes zijn gewist.';
        });
        knop.addEventListener('blur', herstel);
      });
    </script>
  </body>
</html>

<style is:global>
  .overslaan { position: absolute; left: -999px; top: 0; background: var(--rood); color: var(--op-kleur); padding: 0.5rem 1rem; z-index: 100; }
  .overslaan:focus { left: 0.5rem; top: 0.5rem; }
  main { padding-top: 2.5rem; }
</style>
