---
import '../styles/global.css';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import { SITE } from '../lib/site.js';

const { titel, beschrijving = SITE.slogan, datum = SITE.laatstNagelopen, breed = false } = Astro.props;
const paginaTitel = titel ? `${titel} · ${SITE.naam}` : SITE.naam;
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={beschrijving} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <title>{paginaTitel}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.naam} />
    <meta property="og:title" content={paginaTitel} />
    <meta property="og:description" content={beschrijving} />
    <meta property="og:image" content={new URL('/deelplaatje.png', Astro.site)} />
    <meta property="og:locale" content="nl_NL" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:wght@400;700&family=Bricolage+Grotesque:opsz,wght@12..96,700&display=swap" />
  </head>
  <body>
    <a class="overslaan" href="#inhoud">Naar de inhoud</a>
    <Kop />
    <main id="inhoud" class:list={['wrap', { tekst: !breed }]}>
      <slot />
    </main>
    <Voet datum={datum} />
    <script>
      import { lees, wisAlles } from '../lib/opslag.js';
      import { LIJSTEN, SLOT_LIJSTEN, TOTAAL_SLOTEN } from '../data/lijsten.js';
      import { toestandPerKamer } from '../lib/toestand.js';
      import { toestandPerDeel } from '../data/fort.js';

      function telSloten(data) {
        return SLOT_LIJSTEN.reduce((n, id) => {
          const items = data.lijsten[id] ?? {};
          return n + LIJSTEN[id].items.filter((it) => items[it.id]).length;
        }, 0);
      }

      function toonTeller(data = lees()) {
        const el = document.querySelector('[data-sloten]');
        const tekst = document.querySelector('[data-sloten-tekst]');
        if (!el || !tekst) return;
        const dicht = telSloten(data);
        const delen = toestandPerDeel(toestandPerKamer(data));
        const staat = Object.values(delen).filter((t) => t !== 'onbekend').length;
        el.hidden = dicht === 0 && staat === 0;
        tekst.textContent = `${dicht} van ${TOTAAL_SLOTEN} sloten dicht`;
        el.querySelectorAll('[data-kanteel]').forEach((k) => { k.dataset.toestand = delen[k.dataset.kanteel]; });
      }

      // brede tabellen scrollen in hun eigen bak, niet de hele pagina;
      // op een telefoon stapelen ze per rij, met de kolomkop erbij (niet het woordenboek: dat filtert)
      document.querySelectorAll('main table').forEach((t) => {
        const koppen = Array.from(t.querySelectorAll('thead th')).map((th) => th.textContent?.trim() ?? '');
        if (koppen.length >= 3 && !t.closest('[data-woordenboek]')) {
          t.classList.add('tabel-stapel');
          t.querySelectorAll('tbody tr').forEach((rij) => {
            rij.querySelectorAll('td').forEach((cel, i) => { cel.dataset.label = koppen[i] ?? ''; });
          });
        }
        if (t.parentElement?.classList.contains('tabel-scroll')) return;
        const bak = document.createElement('div');
        bak.className = 'tabel-scroll';
        bak.tabIndex = 0;
        bak.setAttribute('role', 'region');
        bak.setAttribute('aria-label', 'Tabel, zijwaarts te scrollen');
        t.replaceWith(bak);
        bak.append(t);
      });

      toonTeller();
      window.addEventListener('jdh:gewijzigd', (e) => toonTeller(e.detail));

      document.querySelectorAll('[data-wis]').forEach((knop) => {
        knop.addEventListener('click', () => {
          wisAlles();
          knop.textContent = 'Antwoorden gewist';
          knop.setAttribute('disabled', '');
        });
      });
    </script>
  </body>
</html>

<style is:global>
  .overslaan { position: absolute; left: -999px; top: 0; background: var(--rood); color: #fff; padding: 0.5rem 1rem; z-index: 100; }
  .overslaan:focus { left: 0.5rem; top: 0.5rem; }
  main { padding-top: 2.5rem; }
</style>
